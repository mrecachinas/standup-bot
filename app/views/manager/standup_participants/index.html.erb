<% content_for :title, "Participants · #{@standup.name}" %>
<% active_count = @participants.count(&:active?) %>
<% stale_count = @participants.count { |participant| participant.timezone_cache_status != "fresh" } %>
<% holiday_today = @standup.holiday_on?(Date.current) %>

<turbo-frame id="standup_participants">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :participants %>

    <% [
      [ @participant&.errors&.any? ? @participant.errors.full_messages : nil, "#{pluralize(@participant&.errors&.count.to_i, "error")} prevented saving this participant" ],
      [ @bulk_import_errors.presence, "Import needs attention" ],
      [ @sync_errors.presence, "Slack sync needs attention" ]
    ].each do |messages, heading| %>
      <% next if messages.blank? %>
      <section class="form-errors" role="alert">
        <h2><%= heading %></h2>
        <ul>
          <% messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="card">
      <div class="card-header">
        <div>
          <h2>Add people</h2>
          <p class="hint">Use a Slack @username, display name, mention, or user ID. Name and timezone are looked up in Slack.</p>
        </div>
      </div>
      <div class="card-body">
        <%= form_with model: @new_participant, url: manager_standup_participants_path(@standup), data: { turbo_frame: "standup_participants" } do |form| %>
          <%= form.hidden_field :active, value: "1" %>
          <div class="input-group">
            <%= form.label :slack_id, "Slack user", class: "sr-only" %>
            <%= form.text_field :slack_id, required: true, placeholder: "@jane, Jane Doe, or U123ABC" %>
            <%= form.submit "Add", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>

      <details class="disclosure" <%= "open" if @bulk_import_errors.present? %>>
        <summary>
          <span class="flex items-center gap-2"><%= icon(:upload) %><span class="strong">Import a list</span><span class="muted small">One person per line</span></span>
        </summary>
        <div class="card-body">
          <%= form_with url: bulk_import_manager_standup_participants_path(@standup), method: :post, data: { turbo_frame: "standup_participants" }, class: "stack" do |form| %>
            <div class="field">
              <%= form.label :participants_text, "Participants" %>
              <%= form.text_area :participants_text, value: @bulk_import_text, rows: 5, placeholder: "@alice\n<@U456|Bob>\nU789,Carol,Europe/London,true", class: "mono" %>
              <span class="hint">Slack username, mention, or ID. Optional extra columns: name, timezone, active.</span>
            </div>
            <%= form.submit "Import participants", class: "btn" %>
          <% end %>
        </div>
      </details>

      <details class="disclosure" <%= "open" if @sync_errors.present? %>>
        <summary>
          <span class="flex items-center gap-2"><%= icon(:refresh) %><span class="strong">Sync from a Slack channel</span><span class="muted small">Adds members and refreshes timezones</span></span>
        </summary>
        <div class="card-body">
          <%= form_with url: sync_manager_standup_participants_path(@standup), method: :post, data: { turbo_frame: "standup_participants" }, class: "stack" do |form| %>
            <div class="field max-w-md">
              <%= form.label :channel, "Channel ID or name" %>
              <%= form.text_field :channel, value: @sync_channel %>
            </div>
            <label class="check">
              <%= form.checkbox :deactivate_missing, checked: @deactivate_missing %>
              Mark people who aren't in the channel as inactive
            </label>
            <%= form.submit "Sync channel", class: "btn" %>
          <% end %>
        </div>
      </details>
    </section>

    <section class="card card-flush" id="standup-managers">
      <div class="card-header">
        <div>
          <h2>Managers</h2>
          <p class="hint">Managers can change this standup's settings, people, and schedule. It doesn't give them access to any other standup.</p>
        </div>
      </div>
      <% if @managers.any? %>
        <ul class="list">
          <% @managers.each do |user| %>
            <li>
              <%= avatar(user.name, url: user.avatar_url) %>
              <div class="grow">
                <div class="cell-title"><%= user.name %><% if user == current_user %> <span class="muted small">(you)</span><% end %></div>
                <div class="cell-sub"><%= user.admin? ? "Admin" : "Manager" %></div>
              </div>
              <% if @managers.size > 1 %>
                <%= button_to "Remove", manager_standup_manager_path(@standup, user),
                  method: :delete,
                  class: "btn btn-ghost btn-sm",
                  form: { data: { turbo_frame: "_top", turbo_confirm: user == current_user ? "Stop managing #{@standup.name}? You'll lose access to it." : "Remove #{user.name} as a manager of #{@standup.name}?" } } %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if @managers.size == 1 %>
          <p class="empty-inline">Make someone else a manager from the list below before you can step down.</p>
        <% end %>
      <% else %>
        <p class="empty-inline">Only admins manage this standup right now. Make someone a manager from the list below.</p>
      <% end %>
    </section>

    <section class="card card-flush">
      <div class="card-header">
        <h2>People</h2>
        <span class="hint">
          <%= pluralize(@participants.count, "participant") %> · <%= active_count %> active
          <% if stale_count.positive? %>· <%= pluralize(stale_count, "timezone") %> needing sync<% end %>
        </span>
      </div>
      <% if @participants.any? %>
        <div class="table-wrap">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Name</th>
                <th>Status</th>
                <th class="hide-sm">Timezone</th>
                <th class="hide-sm">Availability</th>
                <th><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @participants.each do |participant| %>
                <tr id="<%= dom_id(participant) %>">
                  <td>
                    <div class="person">
                      <%= avatar(participant.slack_name.presence || participant.slack_id, url: participant.avatar_url) %>
                      <div>
                        <div class="cell-title"><%= participant.slack_name %></div>
                        <div class="cell-sub"><span class="mono"><%= participant.slack_id %></span><% if (others = @other_standups_by_slack_id[participant.slack_id]).present? %> · Also in <%= others.to_sentence %><% end %></div>
                      </div>
                    </div>
                  </td>
                  <% manager_id = @manager_ids_by_slack_id[participant.slack_id] %>
                  <td>
                    <div class="flex wrap gap-1">
                      <%= participant.active? ? status_badge("Active", "success") : status_badge("Inactive") %>
                      <% if manager_id %><%= status_badge("Manager", "accent") %><% end %>
                    </div>
                  </td>
                  <td class="hide-sm">
                    <div><%= participant.cached_timezone.presence || "Unknown" %></div>
                    <div class="cell-sub" title="<%= participant.timezone_cache_status_description %>">
                      <% if participant.timezone_cache_status == "fresh" %>
                        Synced
                      <% else %>
                        <span class="badge badge-warning badge-plain">Needs sync</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="hide-sm">
                    <div><%= participant.vacation_status_on %></div>
                    <% if holiday_today %>
                      <div class="cell-sub"><%= participant.holiday_status_on %></div>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <details class="menu">
                      <summary class="btn btn-ghost btn-sm" aria-label="Edit <%= participant.slack_name %>"><%= icon(:edit) %> Edit</summary>
                      <div class="menu-panel menu-panel-wide">
                        <%= form_with model: participant, url: manager_standup_participant_path(@standup, participant), data: { turbo_frame: "standup_participants" }, class: "stack-sm card-body" do |form| %>
                          <div class="field">
                            <%= form.label :vacation_until, "Away until", for: "vacation_until_#{participant.id}" %>
                            <%= form.date_field :vacation_until, id: "vacation_until_#{participant.id}" %>
                          </div>
                          <label class="check small">
                            <%= form.checkbox :active, id: "active_#{participant.id}" %>
                            Active
                          </label>
                          <%= form.submit "Save", class: "btn btn-primary btn-sm w-full" %>
                        <% end %>
                        <hr>
                        <% if manager_id %>
                          <% if @managers.size > 1 %>
                            <%= button_to "Remove as manager", manager_standup_manager_path(@standup, manager_id),
                              method: :delete,
                              form: { data: { turbo_frame: "_top", turbo_confirm: "Remove #{participant.slack_name} as a manager of #{@standup.name}?" } } %>
                          <% end %>
                        <% else %>
                          <%= button_to "Make manager", manager_standup_managers_path(@standup),
                            method: :post,
                            params: { participant_id: participant.id },
                            form: { data: { turbo_frame: "_top", turbo_confirm: "Let #{participant.slack_name} manage #{@standup.name}? They'll be able to change its settings, people, and schedule." } } %>
                        <% end %>
                        <%= button_to "Remove from standup", manager_standup_participant_path(@standup, participant),
                          method: :delete,
                          class: "danger",
                          form: { data: { turbo_frame: "standup_participants", turbo_confirm: "Remove #{participant.slack_name} from #{@standup.name}?" } } %>
                      </div>
                    </details>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty">
          <span class="empty-icon"><%= icon(:users) %></span>
          <h3>No participants yet</h3>
          <p>Add people above, or sync everyone from a Slack channel.</p>
        </div>
      <% end %>
    </section>
  </div>
</turbo-frame>
