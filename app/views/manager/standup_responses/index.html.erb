<% content_for :title, "Responses · #{@standup.name}" %>
<turbo-frame id="standup_responses">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :responses %>

    <section class="card">
      <div class="card-body">
        <%= form_with url: manager_standup_responses_path(@standup), method: :get, data: { turbo_frame: "response_history_results", turbo_action: "advance" }, class: "grid grid-4 items-end" do |form| %>
          <div class="field">
            <%= form.label :start_date, "From" %>
            <%= form.date_field :start_date, value: @history.start_date.iso8601 %>
          </div>
          <div class="field">
            <%= form.label :end_date, "To" %>
            <%= form.date_field :end_date, value: @history.end_date.iso8601 %>
          </div>
          <div class="field">
            <%= form.label :participant, "Person" %>
            <%= form.select :participant,
              options_for_select(@history.participant_options.map { |participant| [ participant.label, participant.platform_user_id ] }, @history.participant_slack_id),
              { include_blank: "Everyone" } %>
          </div>
          <div class="field">
            <%= form.label :question, "Question" %>
            <div class="input-group">
              <%= form.select :question,
                options_for_select(@history.question_options, @history.question),
                { include_blank: "All questions" } %>
              <%= form.submit "Apply", class: "btn" %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="card-footer">
        <%= link_to "Reset filters", manager_standup_responses_path(@standup), class: "btn btn-ghost btn-sm", data: { turbo_frame: "_top" } %>
        <%= link_to "View insights",
          manager_standup_analytics_path(@standup, start_date: @history.start_date.iso8601, end_date: @history.end_date.iso8601),
          class: "btn btn-sm",
          data: { turbo_frame: "_top" } %>
      </div>
    </section>

    <turbo-frame id="response_history_results">
      <%= render "history_results", history: @history %>
    </turbo-frame>
  </div>
</turbo-frame>
