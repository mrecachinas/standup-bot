<% summary = history.summary %>
<% answer_rate = summary[:expected].to_i.positive? ? summary[:answered] * 100.0 / summary[:expected] : nil %>

<div class="stack-lg">
  <dl class="stats">
    <div class="stat">
      <dt>Standup dates</dt>
      <dd><%= summary[:dates] %></dd>
    </div>
    <div class="stat">
      <dt>Expected</dt>
      <dd><%= summary[:expected] %></dd>
    </div>
    <div class="stat">
      <dt>Answered</dt>
      <dd><%= summary[:answered] %></dd>
      <span class="stat-sub"><%= answer_rate ? "#{percent(answer_rate)} of expected" : "—" %></span>
    </div>
    <div class="stat">
      <dt>Missed</dt>
      <dd><%= summary[:missed] %></dd>
    </div>
  </dl>

  <% if history.range_limited? %>
    <div class="alert alert-warning"><%= icon(:info) %><span>Showing the most recent <%= StandupResponseHistory::MAX_RANGE_DAYS %> days.</span></div>
  <% end %>

  <% if history.days.any? %>
    <% history.days.each do |day| %>
      <% day_rate = day.expected_count.positive? ? day.answered_count * 100.0 / day.expected_count : 0 %>
      <section id="standup-history-<%= day.date.iso8601 %>" class="card card-flush">
        <div class="card-header">
          <div class="flex items-center gap-3">
            <%= date_tile(day.date) %>
            <div>
              <h2><%= day.date.to_fs(:long) %></h2>
              <p class="hint"><%= day.answered_count %> answered · <%= day.missed_count %> missed · <%= day.expected_count %> expected</p>
            </div>
          </div>
          <div class="meter meter-fixed hide-sm">
            <%= progress_bar(day_rate, tone: rate_tone(day_rate)) %>
            <span class="meter-value small"><%= percent(day_rate) %></span>
          </div>
        </div>

        <ul class="list">
          <% day.entries.each do |entry| %>
            <li id="standup-history-<%= day.date.iso8601 %>-<%= entry.platform_user_id.parameterize %>" class="items-start">
              <%= avatar(entry.display_name.presence || entry.platform_user_id, url: @avatar_urls&.dig(entry.platform_user_id)) %>
              <div class="grow stack-sm">
                <div class="flex wrap items-center gap-2">
                  <span class="cell-title"><%= entry.display_name %></span>
                  <span class="cell-sub mono"><%= entry.platform_user_id %></span>
                  <%= status_badge(entry.status_label, entry.answered? ? "success" : (entry.missed? ? "warning" : nil)) %>
                </div>

                <% if entry.answers.any? %>
                  <div>
                    <% entry.answers.each do |answer| %>
                      <div class="answer">
                        <span class="answer-question"><%= answer.question %></span>
                        <span class="answer-text"><%= answer.text.presence || "No answer provided." %></span>
                        <% if answer.timestamp.present? %>
                          <span class="xsmall subtle">Answered at <%= answer.timestamp_time&.to_fs(:long) || answer.timestamp %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% elsif entry.response && history.question.present? %>
                  <p class="small muted">No answer recorded for “<%= history.question %>”.</p>
                <% elsif entry.response %>
                  <p class="small muted">No submitted answers were recorded for this response.</p>
                <% else %>
                  <p class="small muted">No response submitted for this standup date.</p>
                <% end %>

                <% if entry.response %>
                  <p class="xsmall subtle">
                    Submitted <%= entry.submitted_at&.to_fs(:long) || "Unknown" %> · Last updated <%= entry.updated_at&.to_fs(:long) || "Unknown" %>
                    <% if entry.updated_after_create? %> · Updated after submission<% end %>
                  </p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <div class="card">
      <div class="empty">
        <span class="empty-icon"><%= icon(:inbox) %></span>
        <h3>No runs in this range</h3>
        <p>Try a wider date range or clear the filters.</p>
      </div>
    </div>
  <% end %>
</div>
