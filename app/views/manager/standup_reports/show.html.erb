<turbo-frame id="standup_report">
  <section class="space-y-6">
    <div>
      <%= link_to "← Back to #{@standup.name}", manager_standup_path(@standup), data: { turbo_frame: "_top" }, class: "text-sm text-slate-600" %>
      <p class="mt-2 text-sm font-medium uppercase tracking-wide text-slate-500">Reports</p>
      <h1 class="text-2xl font-bold text-slate-900"><%= @standup.name %></h1>
      <p class="text-sm text-slate-600">Configure report delivery, generate a report now, and review recent generation history.</p>
    </div>

    <% if params[:config_updated].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Report configuration saved.</p>
    <% end %>
    <% if params[:generated].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Report generation queued.</p>
    <% end %>
    <% if @manual_generation_error.present? %>
      <p class="rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"><%= @manual_generation_error %></p>
    <% end %>

    <dl class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Expected</dt>
        <dd class="mt-1 text-2xl font-bold text-slate-900"><%= @summary[:expected_responses] %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Completed</dt>
        <dd class="mt-1 text-2xl font-bold text-slate-900"><%= @summary[:completed_responses] %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Completion rate</dt>
        <dd class="mt-1 text-2xl font-bold text-slate-900"><%= @summary[:completion_rate] %>%</dd>
      </div>
    </dl>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Report configuration</h2>
        <p class="mt-1 text-sm text-slate-600">Slack channel names or IDs are accepted without spaces. Additional recipients can be Slack user IDs or channel IDs.</p>

        <% if @report_configuration.errors.any? %>
          <div class="mt-3 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-800">
            <p class="font-medium">Fix the report configuration:</p>
            <ul class="mt-1 list-disc pl-5">
              <% @report_configuration.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @report_configuration, url: manager_standup_report_path(@standup), method: :patch, data: { turbo_frame: "standup_report" }, class: "mt-4 space-y-4" do |form| %>
          <div>
            <%= form.label :delivery_channel, "Primary report channel", class: "block text-sm font-medium text-slate-700" %>
            <%= form.text_field :delivery_channel, placeholder: "daily-standup or C0123", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
          </div>

          <div>
            <%= form.label :recipients_text, "Additional recipients", class: "block text-sm font-medium text-slate-700" %>
            <%= form.text_area :recipients_text, rows: 4, placeholder: "One Slack user/channel ID per line", class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :report_format, "Format", class: "block text-sm font-medium text-slate-700" %>
              <%= form.select :report_format, ReportConfiguration::REPORT_FORMATS.map { |value, label| [ label, value ] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
            </div>
            <div>
              <%= form.label :detail_level, "Detail level", class: "block text-sm font-medium text-slate-700" %>
              <%= form.select :detail_level, ReportConfiguration::DETAIL_LEVELS.map { |value, label| [ label, value ] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
            </div>
          </div>

          <%= form.submit "Save report settings", class: "rounded bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
        <% end %>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Generate report now</h2>
        <p class="mt-1 text-sm text-slate-600">
          Queues a report for today's standup responses using the saved destination and detail level.
        </p>
        <dl class="mt-4 space-y-2 text-sm">
          <div>
            <dt class="font-medium text-slate-500">Destination</dt>
            <dd class="font-mono text-slate-900"><%= @report_configuration.delivery_channel %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500">Recipients</dt>
            <dd class="text-slate-900"><%= @report_configuration.recipients_text.presence || "No additional recipients" %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500">Detail level</dt>
            <dd class="text-slate-900"><%= ReportConfiguration::DETAIL_LEVELS[@report_configuration.detail_level] %></dd>
          </div>
        </dl>
        <%= button_to "Generate report now", generate_manager_standup_report_path(@standup), method: :post, form: { data: { turbo_frame: "standup_report" }, class: "mt-4" }, class: "rounded bg-blue-700 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-800" %>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Recent report history</h2>

      <% if @report_generations.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead>
              <tr class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                <th class="py-2 pr-4">Requested</th>
                <th class="py-2 pr-4">Status</th>
                <th class="py-2 pr-4">Destination</th>
                <th class="py-2 pr-4">Detail</th>
                <th class="py-2 pr-4">Result</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @report_generations.each do |generation| %>
                <tr>
                  <td class="py-3 pr-4 text-slate-700">
                    <%= generation.requested_at&.strftime("%b %-d, %Y %H:%M") %>
                    <% if generation.actor.present? %>
                      <span class="block text-xs text-slate-500">by <%= generation.actor.name %></span>
                    <% end %>
                  </td>
                  <td class="py-3 pr-4">
                    <span class="rounded-full px-2 py-1 text-xs font-semibold <%= generation.failed? ? "bg-red-100 text-red-800" : generation.succeeded? ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800" %>">
                      <%= generation.status.titleize %>
                    </span>
                  </td>
                  <td class="py-3 pr-4 font-mono text-slate-700"><%= generation.delivery_channel %></td>
                  <td class="py-3 pr-4 text-slate-700"><%= ReportConfiguration::DETAIL_LEVELS[generation.detail_level] || generation.detail_level %></td>
                  <td class="py-3 pr-4 text-slate-700">
                    <% if generation.failed? %>
                      <span class="text-red-700"><%= generation.error_message %></span>
                    <% elsif generation.metadata["response_count"].present? %>
                      <%= pluralize(generation.metadata["response_count"], "response") %> delivered to <%= pluralize(generation.metadata["delivery_count"], "destination") %>
                    <% else %>
                      <%= generation.completed_at.present? ? "Completed" : "Waiting for job" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-slate-600">No reports have been generated yet.</p>
      <% end %>
    </section>
  </section>
</turbo-frame>
