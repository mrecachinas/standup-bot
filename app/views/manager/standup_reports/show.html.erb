<% content_for :title, "Reports · #{@standup.name}" %>
<turbo-frame id="standup_report">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :reports %>

    <% if params[:config_updated].present? %>
      <div class="alert alert-success" role="status"><%= icon(:check_circle) %><span>Report settings saved.</span></div>
    <% end %>
    <% if params[:generated].present? %>
      <div class="alert alert-success" role="status"><%= icon(:check_circle) %><span>Report queued. It will appear in the history below when it's sent.</span></div>
    <% end %>
    <% if @manual_generation_error.present? %>
      <div class="alert alert-warning" role="alert"><%= icon(:alert) %><span><%= @manual_generation_error %></span></div>
    <% end %>

    <div class="grid grid-main-aside grid-gap-lg">
      <div class="stack-lg">
        <section class="card">
          <div class="card-header">
            <div>
              <h2>Delivery settings</h2>
              <p class="hint">Where the end-of-run summary is posted and how much it includes.</p>
            </div>
          </div>
          <%= form_with model: @report_configuration, url: manager_standup_report_path(@standup), method: :patch, data: { turbo_frame: "standup_report" } do |form| %>
            <div class="card-body">
              <% if @report_configuration.errors.any? %>
                <div class="form-errors" role="alert">
                  <h2>Fix the report settings</h2>
                  <ul>
                    <% @report_configuration.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <div class="field">
                <%= form.label :delivery_channel, "Post to channel" %>
                <%= form.text_field :delivery_channel, placeholder: "daily-standup or C0123" %>
                <span class="hint">Channel name or ID, without spaces.</span>
              </div>

              <div class="field">
                <%= form.label :recipients_text, "Also send to" %>
                <%= form.text_area :recipients_text, rows: 3, placeholder: platform_copy(@standup.platform, :recipients_placeholder) %>
                <span class="hint"><%= platform_copy(@standup.platform, :recipients_hint) %></span>
              </div>

              <div class="grid grid-2">
                <div class="field">
                  <%= form.label :report_format, "Format" %>
                  <%= form.select :report_format, ReportConfiguration::REPORT_FORMATS.map { |value, label| [ label, value ] } %>
                </div>
                <div class="field">
                  <%= form.label :detail_level, "Detail" %>
                  <%= form.select :detail_level, ReportConfiguration::DETAIL_LEVELS.map { |value, label| [ label, value ] } %>
                </div>
              </div>
            </div>
            <div class="card-footer">
              <%= form.submit "Save settings", class: "btn btn-primary" %>
            </div>
          <% end %>
        </section>

        <section class="card card-flush">
          <div class="card-header"><h2>History</h2></div>
          <% if @report_generations.any? %>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Requested</th>
                    <th>Status</th>
                    <th class="hide-sm">Sent to</th>
                    <th>Result</th>
                  </tr>
                </thead>
                <tbody>
                  <% @report_generations.each do |generation| %>
                    <tr>
                      <td class="nowrap">
                        <div><%= generation.requested_at&.strftime("%b %-d, %-l:%M %p") %></div>
                        <div class="cell-sub"><%= generation.actor.present? ? "by #{generation.actor.name}" : "Scheduled" %></div>
                      </td>
                      <td><%= status_badge(generation.status.titleize) %></td>
                      <td class="hide-sm">
                        <span class="mono"><%= generation.delivery_channel %></span>
                        <div class="cell-sub"><%= ReportConfiguration::DETAIL_LEVELS[generation.detail_level] || generation.detail_level %></div>
                      </td>
                      <td>
                        <% if generation.failed? %>
                          <span class="small text-danger"><%= generation.error_message %></span>
                        <% elsif generation.metadata["response_count"].present? %>
                          <span class="small"><%= pluralize(generation.metadata["response_count"], "response") %> to <%= pluralize(generation.metadata["delivery_count"], "destination") %></span>
                        <% else %>
                          <span class="small muted"><%= generation.completed_at.present? ? "Completed" : "Waiting for job" %></span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="empty-inline">No reports have been sent yet.</p>
          <% end %>
        </section>
      </div>

      <aside class="stack-lg">
        <section class="card">
          <div class="card-header"><h2>Send a report now</h2></div>
          <div class="card-body">
            <p class="small muted">Builds a report from today's responses using the saved settings.</p>
            <dl class="kv small">
              <dt>Channel</dt>
              <dd class="mono"><%= @report_configuration.delivery_channel.presence || "—" %></dd>
              <dt>Also to</dt>
              <dd><%= @report_configuration.recipients_text.presence || "No one else" %></dd>
              <dt>Detail</dt>
              <dd><%= ReportConfiguration::DETAIL_LEVELS[@report_configuration.detail_level] %></dd>
            </dl>
            <%= button_to generate_manager_standup_report_path(@standup), method: :post, form: { class: "button_to w-full", data: { turbo_frame: "standup_report" } }, class: "btn w-full" do %>
              <%= icon(:send) %> Generate report now
            <% end %>
          </div>
        </section>

        <section class="card">
          <div class="card-header"><h2>Last <%= @summary[:period_days] %> days</h2></div>
          <div class="card-body">
            <dl class="kv small">
              <dt>Completion rate</dt>
              <dd class="strong"><%= percent(@summary[:completion_rate]) %></dd>
              <dt>Completed</dt>
              <dd><%= @summary[:completed_responses] %></dd>
              <dt>Expected</dt>
              <dd><%= @summary[:expected_responses] %></dd>
            </dl>
          </div>
        </section>
      </aside>
    </div>
  </div>
</turbo-frame>
