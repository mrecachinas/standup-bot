<turbo-frame id="<%= dom_id(@standup, :slack_setup) %>">
  <div class="space-y-6">
    <div>
      <%= link_to "← Back to #{@standup.name}", manager_standup_path(@standup), data: { turbo_frame: "_top" }, class: "text-sm text-slate-600" %>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">Slack setup for <%= @standup.name %></h1>
      <p class="mt-1 text-sm text-slate-600">Select Slack resources by ID from discovery, manage participants, and send a safe test message.</p>
    </div>

    <% if params[:channel_updated].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Slack channel updated.</p>
    <% end %>
    <% if params[:participant_added].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Participant added.</p>
    <% end %>
    <% if params[:participant_removed].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Participant removed.</p>
    <% end %>
    <% if params[:test_message_sent].present? %>
      <p class="rounded border border-green-200 bg-green-50 p-3 text-sm text-green-800">Test standup message sent.</p>
    <% end %>

    <%= render "manager/slack_integrations/status", status: @slack_integration_status, connection_result: @connection_result %>

    <section id="slack-channel-setup" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Channel</h2>
      <p class="text-sm text-slate-600">Current Slack channel ID/name: <span class="font-mono"><%= @standup.slack_channel %></span></p>

      <% if @channel_update_error.present? %>
        <p class="mt-2 rounded border border-red-200 bg-red-50 p-2 text-sm text-red-800"><%= @channel_update_error %></p>
      <% end %>

      <%= form_with url: manager_standup_slack_setup_channel_path(@standup), method: :patch, data: { turbo_frame: dom_id(@standup, :slack_setup) }, class: "mt-3 flex flex-col gap-2 md:flex-row" do |form| %>
        <%= form.text_field :channel_id, value: @standup.slack_channel, placeholder: "Slack channel ID (for example C0123)", class: "min-w-0 flex-1 rounded border border-slate-300 px-2 py-1" %>
        <%= form.submit "Save channel", class: "rounded bg-slate-900 px-3 py-1 text-white" %>
      <% end %>

      <div class="mt-4 rounded-md border border-slate-100 p-3">
        <h3 class="font-medium text-slate-800">Discover channels</h3>
        <%= form_with url: manager_standup_slack_setup_path(@standup), method: :get, data: { turbo_frame: dom_id(@standup, :slack_setup) }, class: "mt-2 flex gap-2" do |form| %>
          <%= hidden_field_tag :discover, "channels" %>
          <%= form.search_field :channel_query, value: @channel_query, placeholder: "Search channel name or ID", class: "min-w-0 flex-1 rounded border border-slate-300 px-2 py-1" %>
          <%= form.submit "Find channels", class: "rounded border border-slate-300 px-3 py-1" %>
        <% end %>

        <% if @channel_result.present? %>
          <div class="mt-3">
            <% if @channel_result.success? && @channel_result.records.any? %>
              <ul class="divide-y divide-slate-100 rounded border border-slate-100">
                <% @channel_result.records.each do |channel| %>
                  <li class="flex items-center justify-between gap-3 p-2 text-sm text-slate-700">
                    <div>
                      <p class="font-medium"><%= channel["label"] %></p>
                      <p class="text-xs text-slate-500"><%= channel["id"] %><%= " · private" if channel["is_private"] %><%= " · bot is a member" if channel["is_member"] %></p>
                    </div>
                    <%= button_to "Use channel", manager_standup_slack_setup_channel_path(@standup), method: :patch, params: { channel_id: channel["id"], channel_name: channel["name"] }, form: { data: { turbo_frame: dom_id(@standup, :slack_setup) } }, class: "rounded bg-slate-900 px-3 py-1 text-white" %>
                  </li>
                <% end %>
              </ul>
            <% elsif @channel_result.success? %>
              <p class="text-sm text-slate-600">No channels matched.</p>
            <% else %>
              <div class="rounded border border-amber-200 bg-amber-50 p-2 text-sm text-amber-900">
                <p><%= @channel_result.message %></p>
                <% if @channel_result.action.present? %>
                  <p class="mt-1 font-medium">Next step: <%= @channel_result.action %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section id="slack-participants-setup" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Standup participants</h2>

      <% if @participant_error.present? %>
        <p class="mt-2 rounded border border-red-200 bg-red-50 p-2 text-sm text-red-800"><%= @participant_error %></p>
      <% end %>

      <% if @participants.any? %>
        <ul class="mt-3 divide-y divide-slate-100 rounded border border-slate-100">
          <% @participants.each do |participant| %>
            <li class="flex items-center justify-between gap-3 p-2 text-sm text-slate-700">
              <div>
                <p class="font-medium"><%= participant.slack_name %></p>
                <p class="text-xs text-slate-500"><%= participant.slack_id %><%= " · inactive" unless participant.active? %></p>
              </div>
              <%= button_to "Remove", manager_standup_slack_setup_participant_path(@standup, participant), method: :delete, form: { data: { turbo_confirm: "Remove #{participant.slack_name} from this standup?", turbo_frame: dom_id(@standup, :slack_setup) } }, class: "rounded border border-red-300 px-3 py-1 text-red-700" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-600">No Slack users are configured for this standup.</p>
      <% end %>

      <div class="mt-4 rounded-md border border-slate-100 p-3">
        <h3 class="font-medium text-slate-800">Discover users</h3>
        <%= form_with url: manager_standup_slack_setup_path(@standup), method: :get, data: { turbo_frame: dom_id(@standup, :slack_setup) }, class: "mt-2 flex gap-2" do |form| %>
          <%= hidden_field_tag :discover, "users" %>
          <%= form.search_field :user_query, value: @user_query, placeholder: "Search display name, username, or ID", class: "min-w-0 flex-1 rounded border border-slate-300 px-2 py-1" %>
          <%= form.submit "Find users", class: "rounded border border-slate-300 px-3 py-1" %>
        <% end %>

        <% if @user_result.present? %>
          <div class="mt-3">
            <% if @user_result.success? && @user_result.records.any? %>
              <ul class="divide-y divide-slate-100 rounded border border-slate-100">
                <% @user_result.records.each do |user| %>
                  <li class="flex items-center justify-between gap-3 p-2 text-sm text-slate-700">
                    <div>
                      <p class="font-medium"><%= user["label"] %></p>
                      <p class="text-xs text-slate-500"><%= user["id"] %><%= " · @#{user["name"]}" if user["name"].present? %><%= " · #{user["tz"]}" if user["tz"].present? %></p>
                    </div>
                    <%= button_to "Add user", manager_standup_slack_setup_participants_path(@standup), method: :post, params: { slack_id: user["id"], slack_name: user["label"] }, form: { data: { turbo_frame: dom_id(@standup, :slack_setup) } }, class: "rounded bg-slate-900 px-3 py-1 text-white" %>
                  </li>
                <% end %>
              </ul>
            <% elsif @user_result.success? %>
              <p class="text-sm text-slate-600">No users matched.</p>
            <% else %>
              <div class="rounded border border-amber-200 bg-amber-50 p-2 text-sm text-amber-900">
                <p><%= @user_result.message %></p>
                <% if @user_result.action.present? %>
                  <p class="mt-1 font-medium">Next step: <%= @user_result.action %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section id="slack-test-message" class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Test standup message</h2>
      <p class="text-sm text-slate-600">Send a short test message to <span class="font-mono"><%= @standup.slack_channel %></span> to verify Slack delivery.</p>

      <% if @test_message_result.present? && !@test_message_result.success? %>
        <div class="mt-3 rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
          <p><%= @test_message_result.message %></p>
          <% if @test_message_result.action.present? %>
            <p class="mt-1 font-medium">Next step: <%= @test_message_result.action %></p>
          <% end %>
        </div>
      <% end %>

      <%= button_to "Send test message", manager_standup_slack_setup_test_message_path(@standup), method: :post, form: { data: { turbo_frame: dom_id(@standup, :slack_setup) }, class: "mt-3" }, class: "rounded bg-green-700 px-3 py-1 text-white" %>
    </section>
  </div>
</turbo-frame>
