<% content_for :title, "Slack · #{@standup.name}" %>
<% frame_id = dom_id(@standup, :slack_setup) %>
<% notices = {
  channel_updated: "Slack channel updated.",
  participant_added: "Participant added.",
  participant_removed: "Participant removed.",
  test_message_sent: "Test standup message sent."
} %>

<turbo-frame id="<%= frame_id %>">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :slack %>

    <% notices.each do |param, message| %>
      <% if params[param].present? %>
        <div class="alert alert-success" role="status"><%= icon(:check_circle) %><span><%= message %></span></div>
      <% end %>
    <% end %>

    <div class="grid grid-main-aside grid-gap-lg">
      <div class="stack-lg">
        <section id="slack-channel-setup" class="card card-flush">
          <div class="card-header">
            <div>
              <h2>Summary channel</h2>
              <p class="hint">Currently posting to <span class="mono"><%= @standup.slack_channel %></span></p>
            </div>
          </div>
          <div class="card-body">
            <% if @channel_update_error.present? %>
              <div class="alert alert-danger" role="alert"><%= icon(:alert) %><span><%= @channel_update_error %></span></div>
            <% end %>
            <%= form_with url: manager_standup_slack_setup_channel_path(@standup), method: :patch, data: { turbo_frame: frame_id }, class: "input-group" do |form| %>
              <%= form.label :channel_id, "Channel ID", class: "sr-only" %>
              <%= form.text_field :channel_id, value: @standup.slack_channel, placeholder: "Channel ID, like C0123" %>
              <%= form.submit "Save channel", class: "btn" %>
            <% end %>
            <%= form_with url: manager_standup_slack_setup_path(@standup), method: :get, data: { turbo_frame: frame_id }, class: "input-group" do |form| %>
              <%= hidden_field_tag :discover, "channels", id: nil %>
              <%= form.label :channel_query, "Search channels", class: "sr-only" %>
              <%= form.search_field :channel_query, value: @channel_query, placeholder: "Search channels by name or ID" %>
              <%= form.submit "Find channels", class: "btn" %>
            <% end %>
          </div>
          <% if @channel_result.present? %>
            <div id="slack-channel-results" class="border-top">
              <%= render "discovery_results", result: @channel_result, empty_message: "No channels matched.", action: :use_channel, standup: @standup %>
            </div>
          <% end %>
        </section>

        <section id="slack-participants-setup" class="card card-flush">
          <div class="card-header">
            <div>
              <h2>Find people in Slack</h2>
              <p class="hint">Search your workspace and add people to this standup.</p>
            </div>
            <%= link_to "Manage participants", manager_standup_participants_path(@standup), class: "btn btn-sm", data: { turbo_frame: "_top" } %>
          </div>
          <div class="card-body">
            <% if @participant_error.present? %>
              <div class="alert alert-danger" role="alert"><%= icon(:alert) %><span><%= @participant_error %></span></div>
            <% end %>
            <%= form_with url: manager_standup_slack_setup_path(@standup), method: :get, data: { turbo_frame: frame_id }, class: "input-group" do |form| %>
              <%= hidden_field_tag :discover, "users", id: nil %>
              <%= form.label :user_query, "Search people", class: "sr-only" %>
              <%= form.search_field :user_query, value: @user_query, placeholder: "Search by name, @username, or ID" %>
              <%= form.submit "Find users", class: "btn" %>
            <% end %>
            <%= form_with url: manager_standup_slack_setup_participants_path(@standup), method: :post, data: { turbo_frame: frame_id }, class: "input-group" do |form| %>
              <%= form.label :slack_user, "Add by username", class: "sr-only" %>
              <%= form.text_field :slack_user, placeholder: "Or add directly: @jane, Jane Doe, or U123ABC" %>
              <%= form.submit "Add user", class: "btn" %>
            <% end %>
          </div>
          <% if @user_result.present? %>
            <div class="border-top">
              <%= render "discovery_results", result: @user_result, empty_message: "No users matched.", action: :add_user, standup: @standup %>
            </div>
          <% end %>
          <% if @participants.any? %>
            <div class="border-top">
              <ul class="list">
                <% @participants.each do |participant| %>
                  <li>
                    <%= avatar(participant.slack_name, size: "sm", url: participant.avatar_url) %>
                    <div class="grow">
                      <div class="small strong"><%= participant.slack_name %></div>
                      <div class="cell-sub"><span class="mono"><%= participant.slack_id %></span><%= " · inactive" unless participant.active? %></div>
                    </div>
                    <%= button_to "Remove", manager_standup_slack_setup_participant_path(@standup, participant),
                      method: :delete,
                      form: { data: { turbo_confirm: "Remove #{participant.slack_name} from this standup?", turbo_frame: frame_id } },
                      class: "btn btn-ghost btn-sm" %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </section>
      </div>

      <aside class="stack-lg">
        <section id="slack-test-message" class="card">
          <div class="card-header"><h2>Test message</h2></div>
          <div class="card-body">
            <p class="small muted">Posts a short message to <span class="mono"><%= @standup.slack_channel %></span> so you can confirm the bot can reach it.</p>
            <% if @test_message_result.present? && !@test_message_result.success? %>
              <div class="alert alert-warning">
                <%= icon(:alert) %>
                <div>
                  <p><%= @test_message_result.message %></p>
                  <% if @test_message_result.action.present? %>
                    <p class="small mt-1">Next step: <%= @test_message_result.action %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= button_to manager_standup_slack_setup_test_message_path(@standup), method: :post, form: { class: "button_to w-full", data: { turbo_frame: frame_id } }, class: "btn w-full" do %>
              <%= icon(:send) %> Send test message
            <% end %>
          </div>
        </section>

        <%= render "manager/slack_integrations/status", status: @slack_integration_status, connection_result: @connection_result %>
      </aside>
    </div>
  </div>
</turbo-frame>
