<div class="mt-3">
  <% if result.success? %>
    <% if result.records.any? %>
      <ul class="divide-y divide-slate-100 rounded border border-slate-100">
        <% result.records.each do |record| %>
          <li class="flex items-center justify-between gap-3 p-2 text-sm text-slate-700">
            <span class="min-w-0 truncate">
              <span class="font-medium"><%= record["label"] || record["name"] || record["id"] %></span>
              <span class="text-xs text-slate-500"><%= record["id"] %></span>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-600"><%= empty_message %></p>
    <% end %>
  <% else %>
    <div class="rounded border border-amber-200 bg-amber-50 p-2 text-sm text-amber-900">
      <p><%= result.message %></p>
      <% if result.action.present? %>
        <p class="mt-1 font-medium">Next step: <%= result.action %></p>
      <% end %>
    </div>
  <% end %>
</div>
