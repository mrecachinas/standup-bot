<section id="slack-status" class="card">
  <div class="card-header">
    <div>
      <h2>Slack app status</h2>
      <p class="hint"><%= status[:installation][:message] %></p>
    </div>
    <%= status[:configured] ? status_badge("Connected", "success") : status_badge("Needs setup", "warning") %>
  </div>

  <ul class="list">
    <% status[:credentials].each do |key, credential| %>
      <li id="slack-credential-<%= key %>">
        <span class="<%= credential[:configured] ? "text-success" : (credential[:required] ? "text-warning" : "subtle") %>">
          <%= icon(credential[:configured] ? :check_circle : (credential[:required] ? :x_circle : :info)) %>
        </span>
        <div class="grow">
          <div class="small strong"><%= credential[:label] %><% unless credential[:required] %> <span class="muted normal">(optional)</span><% end %></div>
          <div class="cell-sub"><%= credential[:message] %></div>
        </div>
        <span class="small <%= credential[:configured] ? "muted" : "strong" %>"><%= credential[:configured] ? "Configured" : "Missing" %></span>
      </li>
    <% end %>
  </ul>

  <% if connection_result.present? %>
    <div id="slack-connection-health" class="card-body">
      <div class="alert alert-<%= connection_result.success? ? "success" : "warning" %> w-full">
        <%= icon(connection_result.success? ? :check_circle : :alert) %>
        <div class="stack-sm">
          <p><strong>Slack API connection.</strong> <%= connection_result.message %></p>
          <% if connection_result.success? && connection_result.metadata.present? %>
            <dl class="kv xsmall">
              <% connection_result.metadata.each do |key, value| %>
                <dt><%= key.to_s.humanize %></dt>
                <dd><%= value %></dd>
              <% end %>
            </dl>
          <% elsif connection_result.action.present? %>
            <p class="small">Next step: <%= connection_result.action %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</section>
