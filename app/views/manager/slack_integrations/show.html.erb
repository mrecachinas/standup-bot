<turbo-frame id="slack_integration">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Slack integration</h1>
      <p class="mt-1 text-sm text-slate-600">Review configuration health, discover Slack channels/users, and jump into standup-specific setup.</p>
    </div>

    <%= render "status", status: @slack_integration_status, connection_result: @connection_result %>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Discover Slack resources</h2>
      <p class="text-sm text-slate-600">Discovery shows identifiers and names only. Secrets are never displayed.</p>

      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div id="slack-channel-discovery" class="rounded-md border border-slate-100 p-3">
          <h3 class="font-medium text-slate-800">Channels</h3>
          <%= form_with url: manager_slack_integration_path, method: :get, data: { turbo_frame: "slack_integration" }, class: "mt-2 flex gap-2" do |form| %>
            <%= hidden_field_tag :discover, "channels" %>
            <%= form.search_field :channel_query, value: @channel_query, placeholder: "Search channel name or ID", class: "min-w-0 flex-1 rounded border border-slate-300 px-2 py-1" %>
            <%= form.submit "Find channels", class: "rounded bg-slate-900 px-3 py-1 text-white" %>
          <% end %>

          <% if @channel_result.present? %>
            <%= render "manager/standup_slack_integrations/discovery_results", result: @channel_result, empty_message: "No channels matched." %>
          <% end %>
        </div>

        <div id="slack-user-discovery" class="rounded-md border border-slate-100 p-3">
          <h3 class="font-medium text-slate-800">Users</h3>
          <%= form_with url: manager_slack_integration_path, method: :get, data: { turbo_frame: "slack_integration" }, class: "mt-2 flex gap-2" do |form| %>
            <%= hidden_field_tag :discover, "users" %>
            <%= form.search_field :user_query, value: @user_query, placeholder: "Search display name, username, or ID", class: "min-w-0 flex-1 rounded border border-slate-300 px-2 py-1" %>
            <%= form.submit "Find users", class: "rounded bg-slate-900 px-3 py-1 text-white" %>
          <% end %>

          <% if @user_result.present? %>
            <%= render "manager/standup_slack_integrations/discovery_results", result: @user_result, empty_message: "No users matched." %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900">Standup setup</h2>
      <% if @standups.any? %>
        <ul class="mt-3 divide-y divide-slate-100">
          <% @standups.each do |standup| %>
            <li class="flex items-center justify-between gap-4 py-3">
              <div>
                <p class="font-medium text-slate-900"><%= standup.name %></p>
                <p class="text-sm text-slate-500">Configured channel: <%= standup.slack_channel %></p>
              </div>
              <%= link_to "Configure Slack", manager_standup_slack_setup_path(standup), data: { turbo_frame: "_top" }, class: "rounded border border-slate-300 px-3 py-1 text-sm" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-600">No standups are assigned to you yet.</p>
      <% end %>
    </section>
  </div>
</turbo-frame>
