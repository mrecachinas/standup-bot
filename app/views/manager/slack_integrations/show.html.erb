<% content_for :title, "Slack" %>
<turbo-frame id="slack_integration">
  <div class="page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Slack</h1>
        <p class="page-subtitle">Connection health and workspace lookup. Secrets are never shown.</p>
      </div>
    </div>

    <div class="grid grid-main-aside grid-gap-lg">
      <div class="stack-lg">
        <%= render "status", status: @slack_integration_status, connection_result: @connection_result %>

        <section class="card card-flush">
          <div class="card-header">
            <div>
              <h2>Look up channels and people</h2>
              <p class="hint">Find the IDs to use in standups and reports.</p>
            </div>
          </div>
          <div class="grid grid-2 grid-flush">
            <div id="slack-channel-discovery" class="border-right">
              <%= form_with url: manager_slack_integration_path, method: :get, data: { turbo_frame: "slack_integration" }, class: "card-body input-group" do |form| %>
                <%= hidden_field_tag :discover, "channels", id: nil %>
                <%= form.label :channel_query, "Search channels", class: "sr-only" %>
                <%= form.search_field :channel_query, value: @channel_query, placeholder: "Channel name or ID" %>
                <%= form.submit "Find channels", class: "btn" %>
              <% end %>
              <% if @channel_result.present? %>
                <div class="border-top">
                  <%= render "manager/standup_slack_integrations/discovery_results", result: @channel_result, empty_message: "No channels matched." %>
                </div>
              <% end %>
            </div>
            <div id="slack-user-discovery">
              <%= form_with url: manager_slack_integration_path, method: :get, data: { turbo_frame: "slack_integration" }, class: "card-body input-group" do |form| %>
                <%= hidden_field_tag :discover, "users", id: nil %>
                <%= form.label :user_query, "Search people", class: "sr-only" %>
                <%= form.search_field :user_query, value: @user_query, placeholder: "Name, @username, or ID" %>
                <%= form.submit "Find users", class: "btn" %>
              <% end %>
              <% if @user_result.present? %>
                <div class="border-top">
                  <%= render "manager/standup_slack_integrations/discovery_results", result: @user_result, empty_message: "No users matched.", action: :add_user %>
                </div>
              <% end %>
            </div>
          </div>
        </section>
      </div>

      <aside>
        <section class="card card-flush">
          <div class="card-header"><h2>Standups</h2></div>
          <% if @standups.any? %>
            <ul class="list">
              <% @standups.each do |standup| %>
                <li>
                  <span class="dot <%= standup.active? ? "dot-success" : "dot-warning" %>"></span>
                  <div class="grow">
                    <div class="small strong truncate"><%= standup.name %></div>
                    <div class="cell-sub mono">#<%= standup.platform_channel.to_s.delete_prefix("#") %></div>
                  </div>
                  <%= link_to "Configure", manager_standup_slack_setup_path(standup), data: { turbo_frame: "_top" }, class: "btn btn-sm" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="empty-inline">No standups are assigned to you yet.</p>
          <% end %>
        </section>
      </aside>
    </div>
  </div>
</turbo-frame>
