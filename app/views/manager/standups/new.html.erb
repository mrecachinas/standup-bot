<section class="space-y-6">
  <div class="page-hero">
    <div>
      <p class="page-kicker">Standup wizard</p>
      <h1>Create a standup</h1>
      <p class="mt-4 text-lg">Design the ritual, preview the first sends, and add the initial Slack roster in one pass.</p>
    </div>
  </div>

  <div class="wizard-shell">
    <%= render "wizard_steps" %>
    <div>
      <%= render "form", standup: @standup %>
    </div>
  </div>
</section>
