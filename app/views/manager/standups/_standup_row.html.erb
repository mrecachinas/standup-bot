<% standup = dashboard_item.standup %>
<% rate = dashboard_item.completion_rate %>
<% next_occurrence = dashboard_item.next_occurrence %>
<tr id="<%= dom_id(standup, :dashboard_row) %>">
  <td>
    <div class="flex items-center gap-2">
      <%= link_to standup.name, manager_standup_path(standup), class: "cell-title", data: { turbo_frame: "_top" } %>
      <% unless standup.active? %><%= standup_status_badge(standup) %><% end %>
    </div>
    <div class="cell-sub">#<%= standup.slack_channel.to_s.delete_prefix("#") %></div>
  </td>
  <td class="hide-sm">
    <div><%= schedule_summary(standup) %></div>
    <div class="cell-sub">
      <% if next_occurrence %>
        Next <%= relative_time(next_occurrence.scheduled_at) %>
      <% else %>
        Not scheduled
      <% end %>
    </div>
  </td>
  <td class="hide-sm">
    <% if dashboard_item.participant_count.positive? %>
      <%= avatar_stack(dashboard_item.participant_avatars, limit: 4) %>
      <div class="cell-sub"><%= pluralize(dashboard_item.participant_count, "active participant") %></div>
    <% else %>
      <span class="muted">None yet</span>
    <% end %>
  </td>
  <td>
    <% if dashboard_item.expected_responses.positive? %>
      <div class="meter">
        <%= progress_bar(rate, tone: rate_tone(rate)) %>
        <span class="meter-value"><%= percent(rate) %></span>
      </div>
      <div class="cell-sub"><%= dashboard_item.completed_responses %> of <%= dashboard_item.expected_responses %> responses</div>
    <% else %>
      <span class="muted">No runs yet</span>
    <% end %>
  </td>
  <td class="hide-sm"><%= sparkline(dashboard_item.trend_rates.last(10)) %></td>
  <td class="hide-sm">
    <% if dashboard_item.latest_run_summary %>
      <div class="flex items-center gap-2">
        <span class="nowrap"><%= dashboard_item.latest_run_summary %></span>
        <% if dashboard_item.latest_run_status == "Pending" %><%= status_badge("Pending") %><% end %>
      </div>
    <% else %>
      <span class="muted"><%= dashboard_item.latest_run_status %></span>
    <% end %>
  </td>
  <td class="text-right">
    <details class="menu">
      <summary class="btn btn-ghost btn-sm btn-icon" aria-label="Actions for <%= standup.name %>"><%= icon(:more) %></summary>
      <div class="menu-panel">
        <%= link_to "Edit", edit_manager_standup_path(standup), data: { turbo_frame: "_top" } %>
        <%= link_to "Participants", manager_standup_participants_path(standup), data: { turbo_frame: "_top" } %>
        <%= link_to "Responses", manager_standup_responses_path(standup), data: { turbo_frame: "_top" } %>
        <%= link_to "Insights", manager_standup_analytics_path(standup), data: { turbo_frame: "_top" } %>
        <%= link_to "Reports", manager_standup_report_path(standup), data: { turbo_frame: "_top" } %>
        <%= link_to "Schedule", manager_standup_schedule_exceptions_path(standup), data: { turbo_frame: "_top" } %>
        <hr>
        <% if standup.active? %>
          <%= button_to "Pause", pause_manager_standup_path(standup), method: :patch, form: { data: { turbo_frame: "_top" } }, "aria-label": "Pause #{standup.name}" %>
        <% else %>
          <%= button_to "Resume", resume_manager_standup_path(standup), method: :patch, form: { data: { turbo_frame: "_top" } }, "aria-label": "Resume #{standup.name}" %>
        <% end %>
      </div>
    </details>
  </td>
</tr>
