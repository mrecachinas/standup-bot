<turbo-frame id="<%= dom_id(@standup) %>">
  <section class="space-y-6">
    <div class="page-hero">
      <div>
        <p class="page-kicker">Standup workspace</p>
        <h1><%= @standup.name %></h1>
        <p class="mt-4 text-lg">Configured for #<%= @standup.slack_channel %> with <%= pluralize(@standup.standup_participants.active.count, "active participant") %>.</p>
        <div class="hero-actions mt-5">
          <%= link_to "Edit wizard", edit_manager_standup_path(@standup), class: "button-primary", data: { turbo_frame: "_top" } %>
          <%= link_to "Slack setup", manager_standup_slack_setup_path(@standup), class: "button-ghost", data: { turbo_frame: "_top" } %>
        </div>
      </div>

      <div class="hero-metrics">
        <div class="hero-metric">
          <span>Status</span>
          <strong><%= @standup.active? ? "Active" : "Paused" %></strong>
        </div>
        <div class="hero-metric">
          <span>Send time</span>
          <strong><%= format("%02d:%02d", @standup.default_hour, @standup.default_minute) %></strong>
        </div>
        <div class="hero-metric">
          <span>Cadence</span>
          <strong><%= @standup.schedule_type.titleize %></strong>
        </div>
      </div>
    </div>

    <nav class="action-row" aria-label="<%= @standup.name %> navigation">
      <%= link_to "Participants", manager_standup_participants_path(@standup), class: "button-secondary", data: { turbo_frame: "_top" } %>
      <%= link_to "Schedule exceptions", manager_standup_schedule_exceptions_path(@standup), class: "button-secondary", data: { turbo_frame: "_top" } %>
      <%= link_to "Responses", manager_standup_responses_path(@standup), class: "button-secondary", data: { turbo_frame: "_top" } %>
      <%= link_to "Analytics", manager_standup_analytics_path(@standup), class: "button-secondary", data: { turbo_frame: "_top" } %>
      <%= link_to "Reports", manager_standup_report_path(@standup), class: "button-secondary", data: { turbo_frame: "_top" } %>
    </nav>

    <div class="grid gap-4 lg:grid-cols-3">
      <section class="content-card p-5">
        <h2 class="section-title">Schedule</h2>
        <p class="section-copy">How Slack prompts are sent.</p>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-medium text-slate-500">Recurrence</dt>
            <dd class="text-slate-900"><%= @standup.schedule_type.titleize %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500">Send time</dt>
            <dd class="text-slate-900"><%= format("%02d:%02d", @standup.default_hour, @standup.default_minute) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500">Timezone</dt>
            <dd class="text-slate-900"><%= @standup.respect_timezone? ? "Participant Slack timezones" : "UTC" %></dd>
          </div>
        </dl>
      </section>

      <section class="content-card p-5">
        <h2 class="section-title">Questions</h2>
        <p class="section-copy">Prompts sent to each participant.</p>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-700">
          <% Array(@standup.questions).each do |question| %>
            <li><%= question %></li>
          <% end %>
        </ol>
      </section>

      <section class="content-card p-5">
        <h2 class="section-title">Participants</h2>
        <p class="section-copy">Roster health for this standup.</p>
        <p class="mt-4 text-3xl font-bold text-slate-900"><%= @standup.standup_participants.active.count %></p>
        <p class="text-sm text-slate-500">active of <%= pluralize(@standup.standup_participants.count, "participant") %></p>
        <%= link_to "Manage roster", manager_standup_participants_path(@standup), class: "button-secondary button-small mt-4", data: { turbo_frame: "_top" } %>
      </section>
    </div>

    <%= render "schedule_preview", occurrences: @schedule_preview, preview_timezone: @preview_timezone, schedule_preview_error: @schedule_preview_error %>
  </section>
</turbo-frame>
