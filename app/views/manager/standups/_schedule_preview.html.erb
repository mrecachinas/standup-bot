<turbo-frame id="schedule_preview">
  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-600">Upcoming scheduled occurrences</h3>

    <% if schedule_preview_error.present? %>
      <p class="mt-2 text-sm text-amber-700"><%= schedule_preview_error %></p>
    <% elsif occurrences.present? %>
      <ol class="mt-3 space-y-2">
        <% occurrences.each do |occurrence| %>
          <% local_occurrence = occurrence.in_time_zone(preview_timezone) %>
          <li class="rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-700">
            <time datetime="<%= occurrence.iso8601 %>">
              <%= local_occurrence.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %>
            </time>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">Choose a valid recurrence and send time to preview upcoming runs.</p>
    <% end %>
  </section>
</turbo-frame>
