<turbo-frame id="schedule_preview">
  <% if schedule_preview_error.present? %>
    <p class="empty-inline"><%= schedule_preview_error %></p>
  <% elsif occurrences.present? %>
    <ul class="list">
      <% occurrences.each do |occurrence| %>
        <% local_occurrence = occurrence.in_time_zone(preview_timezone) %>
        <li class="occurrence">
          <%= date_tile(local_occurrence.to_date) %>
          <time datetime="<%= occurrence.iso8601 %>" title="<%= local_occurrence.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %>">
            <span class="strong"><%= local_occurrence.strftime("%A") %></span>
            <span class="cell-sub"><%= local_occurrence.strftime("%-l:%M %p %Z") %></span>
          </time>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-inline">Choose a recurrence and send time to see upcoming runs.</p>
  <% end %>
</turbo-frame>
