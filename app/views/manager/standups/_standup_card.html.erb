<% standup = dashboard_item.standup %>

<turbo-frame id="<%= dom_id(standup, :dashboard_card) %>">
  <article class="standup-card">
    <div class="standup-card-header">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="standup-card-title">
            <%= link_to standup.name, manager_standup_path(standup), data: { turbo_frame: "_top" } %>
          </h2>
          <span class="status-badge <%= standup.active? ? "status-active" : "status-paused" %>">
            <%= dashboard_item.status_label %>
          </span>
        </div>
        <p class="standup-card-meta">Posting summaries to #<%= standup.slack_channel %></p>
      </div>

      <div class="standup-card-actions">
        <% if standup.active? %>
          <%= button_to "Pause",
            pause_manager_standup_path(standup),
            method: :patch,
            class: "button-warning button-small",
            form: { data: { turbo_frame: "_top" } },
            data: { turbo_submits_with: "Pausing..." },
            aria: { label: "Pause #{standup.name}" } %>
        <% else %>
          <%= button_to "Resume",
            resume_manager_standup_path(standup),
            method: :patch,
            class: "button-success button-small",
            form: { data: { turbo_frame: "_top" } },
            data: { turbo_submits_with: "Resuming..." },
            aria: { label: "Resume #{standup.name}" } %>
        <% end %>
      </div>
    </div>

    <div class="standup-card-body">
      <dl class="metadata-list lg:grid-cols-5">
        <div class="metadata-item">
          <dt>Cadence</dt>
          <dd><%= dashboard_item.cadence_label %></dd>
        </div>
        <div class="metadata-item">
          <dt>Timezone</dt>
          <dd><%= dashboard_item.timezone_label %></dd>
        </div>
        <div class="metadata-item">
          <dt>Participants</dt>
          <dd><%= pluralize(dashboard_item.participant_count, "active participant") %></dd>
        </div>
        <div class="metadata-item">
          <dt>Completion</dt>
          <dd><%= dashboard_item.completion_rate %>% (<%= dashboard_item.completed_responses %>/<%= dashboard_item.expected_responses %>)</dd>
        </div>
        <div class="metadata-item">
          <dt>Latest run</dt>
          <dd><%= dashboard_item.latest_run_status %></dd>
          <p class="mt-1 text-xs text-slate-500"><%= dashboard_item.latest_run_detail %></p>
        </div>
      </dl>

      <details class="standup-card-more">
        <summary class="button-secondary button-small">More</summary>
        <div class="standup-card-more-panel">
          <%= link_to "Settings", edit_manager_standup_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
          <%= link_to "Participants", manager_standup_participants_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
          <%= link_to "Responses", manager_standup_responses_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
          <%= link_to "Analytics", manager_standup_analytics_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
          <%= link_to "Reports", manager_standup_report_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
          <%= link_to "Exceptions", manager_standup_schedule_exceptions_path(standup), class: "standup-card-more-link", data: { turbo_frame: "_top" } %>
        </div>
      </details>
    </div>
  </article>
</turbo-frame>
