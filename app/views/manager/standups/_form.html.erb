<turbo-frame id="standup_wizard">
  <%= form_with model: [ :manager, standup ], data: { turbo_frame: "_top" }, class: "space-y-8" do |form| %>
    <% if standup.errors.any? %>
      <section class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-900" aria-labelledby="standup-errors">
        <h2 id="standup-errors" class="text-lg font-semibold"><%= pluralize(standup.errors.count, "error") %> prevented saving</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
          <% standup.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Step 1</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">Basics</h2>
      <p class="mt-1 text-sm text-slate-600">Name the standup and choose where completed summaries post in Slack.</p>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div>
          <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
        </div>
        <div>
          <%= form.label :slack_channel, "Slack channel", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :slack_channel, required: true, placeholder: "eng-standup or C012ABC", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
          <p class="mt-1 text-xs text-slate-500">Use a channel name without spaces. A leading # is okay.</p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Step 2</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">Schedule</h2>
      <p class="mt-1 text-sm text-slate-600">Configure recurrence, send time, and timezone behavior.</p>

      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <div>
          <%= form.label :schedule_type, "Recurrence", class: "block text-sm font-medium text-slate-700" %>
          <%= form.select :schedule_type, Standup::SCHEDULE_TYPES.map { |type| [ type.titleize, type ] }, {}, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
        </div>
        <div>
          <%= label_tag "standup_send_time", "Send time", class: "block text-sm font-medium text-slate-700" %>
          <%= time_field_tag "standup[send_time]", format("%02d:%02d", standup.default_hour || 9, standup.default_minute || 0), id: "standup_send_time", required: true, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
        </div>
        <div>
          <%= form.label :respect_timezone, "Timezone", class: "block text-sm font-medium text-slate-700" %>
          <%= form.select :respect_timezone,
            [
              [ "Use each participant's Slack timezone", true ],
              [ "Use UTC for everyone", false ]
            ],
            {},
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
        </div>
      </div>

      <div class="mt-5 grid gap-4 lg:grid-cols-[2fr_1fr]">
        <div>
          <span class="block text-sm font-medium text-slate-700">Weekdays</span>
          <%= hidden_field_tag "standup[schedule_days][]", "" %>
          <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            <% Manager::StandupsController::WEEKDAY_OPTIONS.each do |label, value| %>
              <% checkbox_id = "standup_schedule_day_#{value}" %>
              <label for="<%= checkbox_id %>" class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm">
                <%= check_box_tag "standup[schedule_days][]", value, Array(standup.schedule_days).map(&:to_i).include?(value), id: checkbox_id, class: "rounded border-slate-300" %>
                <span><%= label %></span>
              </label>
            <% end %>
          </div>
          <p class="mt-1 text-xs text-slate-500">Weekly, biweekly, and custom schedules use these days. Daily and weekdays ignore this selection.</p>
        </div>
        <div>
          <%= label_tag "standup_monthly_day", "Monthly day", class: "block text-sm font-medium text-slate-700" %>
          <%= number_field_tag "standup[monthly_day]", Array(standup.schedule_days).first.presence || 1, id: "standup_monthly_day", in: 1..31, class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
          <p class="mt-1 text-xs text-slate-500">Monthly schedules use this day and fall back to month-end when needed.</p>
        </div>
      </div>

      <div class="mt-5 flex flex-col gap-3 rounded-xl bg-slate-50 p-4 md:flex-row md:items-end md:justify-between">
        <div class="w-full md:max-w-sm">
          <%= label_tag "preview_timezone", "Preview timezone", class: "block text-sm font-medium text-slate-700" %>
          <%= select_tag "preview_timezone", options_for_select(@time_zone_options || ActiveSupport::TimeZone.all.map(&:name), @preview_timezone), class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" %>
        </div>
        <button type="submit" formaction="<%= preview_manager_standups_path %>" formmethod="post" data-turbo-frame="schedule_preview" class="rounded-lg border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50">
          Preview schedule
        </button>
      </div>

      <%= render "schedule_preview", occurrences: @schedule_preview, preview_timezone: @preview_timezone, schedule_preview_error: @schedule_preview_error %>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Step 3</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">Questions</h2>
      <p class="mt-1 text-sm text-slate-600">Edit prompts, add more as needed, and use the move controls to set the order. Blank rows are ignored.</p>

      <div class="mt-5 space-y-3" data-question-editor>
        <div class="space-y-3" data-question-list>
          <% @question_rows.each_with_index do |question, index| %>
            <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3 md:grid-cols-[auto_1fr_auto] md:items-center" data-question-row>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-semibold text-slate-700 shadow-sm" data-question-position><%= index + 1 %></span>
              <%= text_field_tag "standup[question_rows][]", question, placeholder: "What do you plan to work on today?", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2", data: { question_input: true }, aria: { label: "Question #{index + 1}" } %>
              <div class="flex gap-1">
                <button type="button" class="rounded-md border border-slate-300 bg-white px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50" data-question-move="up" aria-label="Move question <%= index + 1 %> up">
                  Up
                </button>
                <button type="button" class="rounded-md border border-slate-300 bg-white px-2 py-1 text-sm font-semibold text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50" data-question-move="down" aria-label="Move question <%= index + 1 %> down">
                  Down
                </button>
              </div>
            </div>
          <% end %>
        </div>
        <button type="button" class="rounded-lg border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" data-question-add>
          Add another question
        </button>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Step 4</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">Participants</h2>
      <p class="mt-1 text-sm text-slate-600">Add Slack users during setup. Existing rows can be updated, paused, or removed.</p>

      <div class="mt-5 overflow-hidden rounded-xl border border-slate-200">
        <div class="hidden grid-cols-[1.1fr_1.2fr_1.2fr_0.7fr_0.7fr] gap-3 bg-slate-50 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 md:grid">
          <span>Slack ID</span>
          <span>Name</span>
          <span>Timezone</span>
          <span>Active</span>
          <span>Remove</span>
        </div>

        <div class="divide-y divide-slate-200">
          <% @participant_rows.each_with_index do |participant, index| %>
            <div class="grid gap-3 px-4 py-4 md:grid-cols-[1.1fr_1.2fr_1.2fr_0.7fr_0.7fr] md:items-center">
              <%= hidden_field_tag "standup[participants][#{index}][id]", participant[:id] %>
              <div>
                <%= label_tag "standup_participants_#{index}_slack_id", "Slack ID", class: "block text-xs font-medium text-slate-500 md:hidden" %>
                <%= text_field_tag "standup[participants][#{index}][slack_id]", participant[:slack_id], id: "standup_participants_#{index}_slack_id", placeholder: "U123ABC", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 md:mt-0" %>
              </div>
              <div>
                <%= label_tag "standup_participants_#{index}_slack_name", "Name", class: "block text-xs font-medium text-slate-500 md:hidden" %>
                <%= text_field_tag "standup[participants][#{index}][slack_name]", participant[:slack_name], id: "standup_participants_#{index}_slack_name", placeholder: "Ada Lovelace", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 md:mt-0" %>
              </div>
              <div>
                <%= label_tag "standup_participants_#{index}_cached_timezone", "Timezone", class: "block text-xs font-medium text-slate-500 md:hidden" %>
                <%= text_field_tag "standup[participants][#{index}][cached_timezone]", participant[:cached_timezone], id: "standup_participants_#{index}_cached_timezone", placeholder: "America/New_York", class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 md:mt-0" %>
              </div>
              <label class="flex items-center gap-2 text-sm text-slate-700">
                <%= hidden_field_tag "standup[participants][#{index}][active]", "0" %>
                <%= check_box_tag "standup[participants][#{index}][active]", "1", participant[:active], class: "rounded border-slate-300" %>
                Active
              </label>
              <label class="flex items-center gap-2 text-sm text-slate-700">
                <%= hidden_field_tag "standup[participants][#{index}][_destroy]", "0" %>
                <%= check_box_tag "standup[participants][#{index}][_destroy]", "1", participant[:destroy], class: "rounded border-slate-300" %>
                Remove
              </label>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit standup.persisted? ? "Update standup" : "Create standup", class: "rounded-lg bg-blue-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-800" %>
      <%= link_to "Cancel", standup.persisted? ? manager_standup_path(standup) : manager_standups_path, class: "rounded-lg px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</turbo-frame>
