<% picker = schedule_picker_state(standup) %>
<% chat = standup.chat_platform %>
<% advanced_open = picker[:frequency] != "weekly" || !standup.respect_timezone? || standup.errors.any? %>
<% question_suggestions = [
  "What did you get done yesterday?",
  "What are you working on today?",
  "Is anything blocking you?",
  "What are you proud of this week?",
  "Where could you use help?",
  "How are you feeling today, from 1 to 5?"
] %>

<turbo-frame id="standup_wizard">
  <%= form_with model: [ :manager, standup ], data: { turbo_frame: "_top", unsaved_guard: true }, class: "editor" do |form| %>
    <% if standup.errors.any? %>
      <section class="form-errors" aria-labelledby="standup-errors" role="alert">
        <h2 id="standup-errors"><%= pluralize(standup.errors.count, "error") %> prevented saving</h2>
        <ul>
          <% standup.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="editor-layout">
      <div class="stack-lg">
        <section class="card" id="basics">
          <% if standup.new_record? && @platform_options.size > 1 %>
            <div class="card-header" id="platform-picker">
              <div>
                <h2>Chat platform</h2>
                <p class="hint">Where people get their questions. This can't be changed later.</p>
              </div>
              <div class="flex gap-2" role="group" aria-label="Chat platform">
                <% @platform_options.each do |key| %>
                  <%= link_to new_manager_standup_path(platform: key, template: @template_key), class: [ "btn btn-sm", ("btn-primary" if key == standup.platform) ].compact.join(" "), aria: { pressed: key == standup.platform }, data: { turbo_frame: "_top" } do %>
                    <%= icon(platform_icon(key)) %> <%= platform_label(key) %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= form.hidden_field :platform if standup.new_record? %>
          <div class="card-body"><div class="grid grid-2">
            <div class="field">
              <%= form.label :name %>
              <%= form.text_field :name, required: true, placeholder: "Platform daily", autofocus: standup.new_record? %>
            </div>
            <div class="field">
              <%= form.label :platform_channel, "Post summaries to" %>
              <% if chat.key == :teams %>
                <% channel_records = @channel_options&.success? ? @channel_options.records : [] %>
                <% channel_choices = channel_records.map { |record| [ record["label"], record["id"] ] } %>
                <% if standup.platform_channel.present? && channel_choices.none? { |_label, id| id == standup.platform_channel } %>
                  <% channel_choices.unshift([ standup.platform_channel_name.presence || standup.platform_channel, standup.platform_channel ]) %>
                <% end %>
                <% if channel_records.any? %>
                  <%= form.select :platform_channel, channel_choices,
                    { include_blank: "Pick a Teams channel", selected: standup.platform_channel },
                    required: true, data: { channel_name_source: true } %>
                  <%= form.hidden_field :platform_channel_name, data: { channel_name_target: true } %>
                <% else %>
                  <%= form.text_field :platform_channel, required: true, placeholder: platform_copy(:teams, :channel_id_placeholder) %>
                  <span class="hint"><%= @channel_options&.message || "Set up Teams on the Integrations page to pick a channel from a list." %></span>
                <% end %>
              <% else %>
                <div class="input-prefix">
                  <span>#</span>
                  <%= form.text_field :platform_channel, value: standup.platform_channel.to_s.delete_prefix("#"), required: true, placeholder: "eng-standup" %>
                </div>
              <% end %>
            </div>
          </div></div>
        </section>

        <section class="card" id="schedule">
          <div class="card-header">
            <div>
              <h2>When</h2>
              <p class="hint" data-schedule-summary><%= schedule_sentence(standup) %></p>
            </div>
          </div>
          <div class="card-body">
            <div class="schedule-row">
              <fieldset class="fieldset-reset field" data-day-picker>
                <legend class="label">Days</legend>
                <div class="chips mt-2" data-schedule-input>
                  <%= hidden_field_tag "standup[days][]", "", id: nil %>
                  <% Manager::StandupsController::WEEKDAY_OPTIONS.rotate(1).each do |label, value| %>
                    <label class="chip-toggle" title="<%= label %>">
                      <%= check_box_tag "standup[days][]", value, picker[:days].include?(value), id: "standup_day_#{value}" %>
                      <span><%= label.first(3) %></span>
                    </label>
                  <% end %>
                </div>
                <div class="day-presets">
                  <button type="button" class="link-button" data-set-days="1,2,3,4,5">Weekdays</button>
                  <button type="button" class="link-button" data-set-days="0,1,2,3,4,5,6">Every day</button>
                  <button type="button" class="link-button" data-set-days="1,3,5">Mon, Wed, Fri</button>
                </div>
              </fieldset>
              <div class="field" data-monthly-schedule-section data-schedule-input>
                <%= label_tag "standup_monthly_day", "Day of the month" %>
                <%= number_field_tag "standup[monthly_day]", picker[:monthly_day] || 1, id: "standup_monthly_day", in: 1..31 %>
              </div>
              <div class="field time-field" data-schedule-input>
                <%= label_tag "standup_send_time", "At" %>
                <%= time_field_tag "standup[send_time]", format("%02d:%02d", standup.default_hour || 9, standup.default_minute || 0), id: "standup_send_time", required: true %>
              </div>
            </div>
          </div>
        </section>

        <section class="card" id="questions">
          <div class="card-header">
            <div>
              <h2>Questions</h2>
              <p class="hint">Asked one at a time in a <%= chat.label %> DM. Press Enter to add another.</p>
            </div>
          </div>
          <div class="card-body">
            <div class="row-editor" data-row-editor data-question-editor>
              <div class="row-editor" data-rows>
                <% @question_rows.each_with_index do |question, index| %>
                  <div class="question-row" data-row>
                    <span class="row-editor-index" data-row-index><%= index + 1 %></span>
                    <%= text_field_tag "standup[question_rows][]", question, id: nil, placeholder: "Ask something…", "aria-label": "Question #{index + 1}", data: { question_input: true } %>
                    <span class="question-row-actions">
                      <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move-row="up" aria-label="Move up"><%= icon(:chevron_up) %></button>
                      <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move-row="down" aria-label="Move down"><%= icon(:chevron_down) %></button>
                      <button type="button" class="btn btn-ghost btn-sm btn-icon" data-remove-row aria-label="Remove question"><%= icon(:x) %></button>
                    </span>
                  </div>
                <% end %>
              </div>
              <template>
                <div class="question-row" data-row>
                  <span class="row-editor-index" data-row-index></span>
                  <input type="text" name="standup[question_rows][]" placeholder="Ask something…" aria-label="Question" data-question-input>
                  <span class="question-row-actions">
                    <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move-row="up" aria-label="Move up"><%= icon(:chevron_up) %></button>
                    <button type="button" class="btn btn-ghost btn-sm btn-icon" data-move-row="down" aria-label="Move down"><%= icon(:chevron_down) %></button>
                    <button type="button" class="btn btn-ghost btn-sm btn-icon" data-remove-row aria-label="Remove question"><%= icon(:x) %></button>
                  </span>
                </div>
              </template>
              <div class="flex wrap items-center gap-2">
                <button type="button" class="btn btn-sm" data-add-row><%= icon(:plus) %> Add question</button>
                <span class="small muted">or try:</span>
                <% question_suggestions.each do |suggestion| %>
                  <button type="button" class="suggestion" data-suggestion="<%= suggestion %>" <%= "hidden" if @question_rows.include?(suggestion) %>><%= suggestion %></button>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <section class="card" id="participants">
          <div class="card-header">
            <div>
              <h2>People</h2>
              <p class="hint">Names and timezones come from <%= chat.label %>.<% if standup.persisted? %> Set time away and more on the <%= link_to "Participants", manager_standup_participants_path(standup), data: { turbo_frame: "_top" } %> tab.<% end %></p>
            </div>
          </div>
          <div class="card-body">
            <div class="people" data-people>
              <% @participant_rows.each_with_index do |participant, index| %>
                <%= render "person_chip", participant: participant, index: index %>
              <% end %>
            </div>
            <div class="field">
              <%= label_tag "standup_participant_handles", "Add people", class: "sr-only" %>
              <%= text_field_tag "standup[participant_handles]", nil, id: "standup_participant_handles", placeholder: "Add people: @ada, Grace Hopper, or U123ABC, then press Enter", autocomplete: "off", data: { people_input: true } %>
              <span class="hint">Separate several people with commas.</span>
            </div>
            <template data-person-template>
              <span class="person-chip is-pending" data-person-chip>
                <input type="hidden" name="standup[participants][__INDEX__][platform_user_id]" data-person-handle>
                <input type="hidden" name="standup[participants][__INDEX__][active]" value="1">
                <%= avatar("?", size: "sm") %>
                <span class="person-chip-name" data-person-label></span>
                <span class="person-chip-meta">looked up on save</span>
                <button type="button" class="person-chip-remove" data-person-remove aria-label="Remove"><%= icon(:x) %></button>
              </span>
            </template>
          </div>
        </section>

        <details class="card disclosure" id="advanced" <%= "open" if advanced_open %>>
          <summary>
            <span>
              <span class="strong">Advanced settings</span>
              <span class="small muted">Repeat interval, timezone, reminders, and messages</span>
            </span>
          </summary>
          <div class="card-body">
            <fieldset class="fieldset-reset field" data-schedule-input>
              <legend class="label">Repeat</legend>
              <div class="segmented-choice mt-2">
                <% [ [ "weekly", "Every week" ], [ "biweekly", "Every other week" ], [ "monthly", "Once a month" ] ].each do |value, label| %>
                  <label>
                    <%= radio_button_tag "standup[frequency]", value, picker[:frequency] == value, data: { frequency_input: true } %>
                    <span><%= label %></span>
                  </label>
                <% end %>
              </div>
              <span class="hint" data-biweekly-hint>Every other week runs on a single day.</span>
            </fieldset>

            <div class="field max-w-md" data-schedule-input>
              <%= form.label :respect_timezone, "Send at" %>
              <%= form.select :respect_timezone, [ [ "Each person's local time", true ], [ "The same moment for everyone (UTC)", false ] ], {}, data: { timezone_mode: true } %>
            </div>

            <fieldset class="fieldset-reset field">
              <legend class="label">Reminders</legend>
              <div class="inline-fields mt-2">
                <label class="check">
                  <%= form.check_box :reminder_enabled %>
                  Remind people who haven't answered after
                </label>
                <%= form.number_field :reminder_after_minutes, min: 1, step: 1, class: "input-narrow", "aria-label": "Minutes before the first reminder" %>
                <span>minutes, up to</span>
                <%= form.number_field :max_reminders, min: 0, step: 1, class: "input-narrow", "aria-label": "Maximum reminders" %>
                <span>times</span>
              </div>
            </fieldset>

            <div class="grid grid-2">
              <div class="field">
                <%= form.label :intro, "Greeting" %>
                <%= form.text_area :intro, rows: 3, placeholder: "Morning! Time for a quick standup.", data: { intro_input: true } %>
              </div>
              <div class="field">
                <%= form.label :outro, "Sign-off" %>
                <%= form.text_area :outro, rows: 3, placeholder: "Thanks, have a good day." %>
              </div>
            </div>
          </div>
        </details>

        <div class="form-actions">
          <%= link_to "Cancel", standup.persisted? ? manager_standup_path(standup) : manager_standups_path, class: "btn btn-ghost", data: { turbo_frame: "_top" } %>
          <%= form.submit standup.persisted? ? "Save changes" : "Create standup", class: "btn btn-primary" %>
        </div>
      </div>

      <aside class="editor-aside stack-lg">
        <section class="card">
          <div class="card-header"><h2>What people see</h2></div>
          <div class="card-body">
            <div class="slack-preview" aria-label="Preview of the <%= chat.label %> DM">
              <span class="slack-preview-icon"><%= icon(:logo) %></span>
              <div class="grow">
                <div class="slack-preview-meta"><strong>Standup Bot</strong> <span class="slack-app-tag">APP</span> <span class="muted" data-preview-time><%= format_clock(standup.default_hour || 9, standup.default_minute || 0) %></span></div>
                <p class="slack-preview-text" data-preview-intro><%= standup.intro %></p>
                <p class="slack-preview-question">
                  <span class="muted small" data-preview-count>Question 1 of <%= [ @question_rows.count(&:present?), 1 ].max %></span>
                  <span data-preview-question><%= @question_rows.find(&:present?) || "Your first question shows up here." %></span>
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="card card-flush">
          <div class="card-header">
            <h2>Next runs</h2>
            <div class="input-group items-center grow" data-schedule-input>
              <%= label_tag "preview_timezone", "Preview timezone", class: "sr-only" %>
              <%= select_tag "preview_timezone", options_for_select(@time_zone_options || ActiveSupport::TimeZone.all.map(&:name), @preview_timezone), class: "select-compact", data: { detect_timezone: (true if @detect_preview_timezone) } %>
              <button type="submit" formaction="<%= preview_manager_standups_path %>" formmethod="post" formnovalidate data-turbo-frame="schedule_preview" data-preview-button class="btn btn-sm btn-ghost btn-icon" title="Preview schedule" aria-label="Preview schedule"><%= icon(:refresh) %></button>
            </div>
          </div>
          <%= render "schedule_preview", occurrences: @schedule_preview, preview_timezone: @preview_timezone, schedule_preview_error: @schedule_preview_error %>
        </section>
      </aside>
    </div>
  <% end %>
</turbo-frame>
