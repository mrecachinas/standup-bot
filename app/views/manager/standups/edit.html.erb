<section class="space-y-6">
  <div class="page-hero">
    <div>
      <p class="page-kicker">Standup wizard</p>
      <h1>Edit <%= @standup.name %></h1>
      <p class="mt-4 text-lg">Adjust cadence, prompts, and participants with a live schedule preview before saving.</p>
    </div>
  </div>

  <div class="wizard-shell">
    <%= render "wizard_steps" %>
    <div>
      <%= render "form", standup: @standup %>
    </div>
  </div>
</section>
