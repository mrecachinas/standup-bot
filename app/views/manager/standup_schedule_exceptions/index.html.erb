<% content_for :title, "Schedule · #{@standup.name}" %>
<% frame_id = dom_id(@standup, :schedule_exceptions) %>

<turbo-frame id="<%= frame_id %>">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :schedule %>

    <% if @schedule_exception.errors.any? %>
      <section class="form-errors" role="alert" aria-labelledby="schedule-exception-errors">
        <h2 id="schedule-exception-errors"><%= pluralize(@schedule_exception.errors.count, "error") %> prevented saving</h2>
        <ul>
          <% @schedule_exception.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="grid grid-main-aside grid-gap-lg">
      <div class="stack-lg">
        <section class="card card-flush">
          <div class="card-header">
            <div>
              <h2>Upcoming runs</h2>
              <p class="hint">Includes skipped and moved dates</p>
            </div>
            <%= form_with url: manager_standup_schedule_exceptions_path(@standup), method: :get, data: { turbo_frame: frame_id }, class: "input-group" do %>
              <%= label_tag :preview_timezone, "Show times in", class: "sr-only" %>
              <%= select_tag :preview_timezone, options_for_select(@time_zone_options, @preview_timezone) %>
              <%= submit_tag "Refresh", class: "btn" %>
            <% end %>
          </div>

          <% if @upcoming_occurrences.any? %>
            <ul class="list">
              <% @upcoming_occurrences.each do |occurrence| %>
                <% local_occurrence = occurrence.scheduled_at.in_time_zone(@preview_timezone) %>
                <li class="occurrence">
                  <%= date_tile(local_occurrence.to_date, blocked: occurrence.blocked?) %>
                  <div class="grow">
                    <div class="<%= "muted" if occurrence.blocked? %>">
                      <time datetime="<%= occurrence.scheduled_at.iso8601 %>"><%= local_occurrence.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %></time>
                    </div>
                    <% note = occurrence.exception&.reason.presence || ("No prompts will be sent" if occurrence.blocked?) %>
                    <% if note %><div class="cell-sub"><%= note %></div><% end %>
                  </div>
                  <%= status_badge(occurrence.status_label, occurrence.sendable? ? (occurrence.exception ? "info" : "success") : "warning") %>
                  <% if occurrence.sendable? && occurrence.exception.nil? %>
                    <%= button_to "Skip",
                      manager_standup_schedule_exceptions_path(@standup),
                      method: :post,
                      params: { schedule_exception: { exception_type: "skipped_date", original_date: occurrence.standup_date.iso8601, reason: "Skipped" } },
                      class: "btn btn-sm",
                      form: { data: { turbo_frame: frame_id } },
                      "aria-label": "Skip #{occurrence.standup_date.to_fs(:long)}" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="empty-inline">No upcoming occurrences could be calculated for this schedule.</p>
          <% end %>
        </section>

        <section class="card card-flush">
          <div class="card-header"><h2>Exceptions</h2></div>
          <% if @schedule_exceptions.any? %>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th class="hide-sm">Moved to</th>
                    <th class="hide-sm">Reason</th>
                    <th><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  <% @schedule_exceptions.each do |schedule_exception| %>
                    <tr>
                      <td class="nowrap"><%= schedule_exception.original_date.to_fs(:long) %></td>
                      <td><%= status_badge(schedule_exception.label) %></td>
                      <td class="hide-sm">
                        <% if schedule_exception.rescheduled? %>
                          <%= schedule_exception.scheduled_at.in_time_zone(schedule_exception.rescheduled_timezone).strftime("%a, %b %-d at %-l:%M %p %Z") %>
                        <% else %>
                          <span class="subtle">—</span>
                        <% end %>
                      </td>
                      <td class="hide-sm"><%= schedule_exception.reason.presence || tag.span("—", class: "subtle") %></td>
                      <td class="text-right">
                        <%= button_to "Remove",
                          manager_standup_schedule_exception_path(@standup, schedule_exception),
                          method: :delete,
                          class: "btn btn-ghost btn-sm",
                          form: { data: { turbo_frame: frame_id } } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="empty-inline">No skipped, holiday, or moved dates yet.</p>
          <% end %>
        </section>
      </div>

      <aside class="stack-lg">
        <section class="card">
          <div class="card-header">
            <h2>Regular schedule</h2>
            <%= link_to "Edit", edit_manager_standup_path(@standup, anchor: "schedule"), class: "btn btn-ghost btn-sm", data: { turbo_frame: "_top" } %>
          </div>
          <div class="card-body">
            <p><%= schedule_summary(@standup) %></p>
            <p class="small muted">Pausing stops all runs until you resume. Saved exceptions are kept.</p>
            <% if @standup.active? %>
              <%= button_to "Pause standup", pause_manager_standup_path(@standup), method: :patch, class: "btn btn-sm", form: { data: { turbo_frame: "_top" } } %>
            <% else %>
              <%= button_to "Resume standup", resume_manager_standup_path(@standup), method: :patch, class: "btn btn-sm", form: { data: { turbo_frame: "_top" } } %>
            <% end %>
          </div>
        </section>

        <section class="card">
          <div class="card-header"><h2>Skip a date</h2></div>
          <%= form_with url: manager_standup_schedule_exceptions_path(@standup), scope: :schedule_exception, data: { turbo_frame: frame_id }, class: "card-body" do |form| %>
            <div class="field">
              <%= form.label :original_date, "Date" %>
              <%= form.date_field :original_date, required: true %>
            </div>
            <div class="field">
              <%= form.label :exception_type, "Type" %>
              <%= form.select :exception_type, [ [ "Skipped date", "skipped_date" ], [ "Holiday", "holiday" ] ] %>
            </div>
            <div class="field">
              <%= form.label :reason, "Reason", for: "skip_reason" %>
              <%= form.text_field :reason, id: "skip_reason", placeholder: "Company holiday, offsite…" %>
            </div>
            <%= form.submit "Save exception", class: "btn btn-primary w-full" %>
          <% end %>
        </section>

        <section class="card">
          <div class="card-header"><h2>Move the next run</h2></div>
          <% if @next_occurrence %>
            <% next_local = @next_occurrence.scheduled_at.in_time_zone(@preview_timezone) %>
            <%= form_with url: manager_standup_schedule_exceptions_path(@standup), scope: :schedule_exception, data: { turbo_frame: frame_id }, class: "card-body" do |form| %>
              <p class="small muted">Currently <strong><%= next_local.strftime("%A, %B %-d, %Y at %-l:%M %p %Z") %></strong>.</p>
              <%= form.hidden_field :exception_type, value: "rescheduled" %>
              <%= form.hidden_field :original_date, value: @next_occurrence.standup_date.iso8601 %>
              <div class="stack">
                <div class="field">
                  <%= form.label :rescheduled_date, "New date" %>
                  <%= form.date_field :rescheduled_date, value: next_local.to_date.iso8601, required: true %>
                </div>
                <div class="field">
                  <%= form.label :rescheduled_time, "New time" %>
                  <%= form.time_field :rescheduled_time, value: next_local.strftime("%H:%M"), required: true %>
                </div>
              </div>
              <div class="field">
                <%= form.label :rescheduled_timezone, "Timezone" %>
                <%= form.select :rescheduled_timezone, options_for_select(@time_zone_options, @preview_timezone) %>
              </div>
              <div class="field">
                <%= form.label :reason, "Reason", for: "move_reason" %>
                <%= form.text_field :reason, id: "move_reason", placeholder: "Team offsite" %>
              </div>
              <div class="btn-row">
                <%= form.submit "Move run", class: "btn btn-primary" %>
              </div>
            <% end %>
            <div class="card-footer">
              <%= button_to "Cancel next run",
                manager_standup_schedule_exceptions_path(@standup),
                method: :post,
                params: {
                  schedule_exception: {
                    exception_type: "cancelled",
                    original_date: @next_occurrence.standup_date.iso8601,
                    reason: "One-off cancellation"
                  }
                },
                class: "btn btn-danger btn-sm",
                form: { data: { turbo_frame: frame_id, turbo_confirm: "Cancel the run on #{next_local.strftime("%A, %B %-d")}?" } } %>
            </div>
          <% else %>
            <p class="empty-inline">There's no upcoming run to move.</p>
          <% end %>
        </section>

        <section class="small muted stack-sm">
          <p>Skipped, holiday, and canceled dates do not create prompts, reminders, or expected report rows.</p>
          <p>Moved runs replace the original send time and reminders follow the new time, while responses and reports stay attached to the original standup date.</p>
        </section>
      </aside>
    </div>
  </div>
</turbo-frame>
