<% content_for :title, "Insights · #{@standup.name}" %>
<% range_days = (@analytics.end_date - @analytics.start_date).to_i + 1 %>
<% has_data = @summary[:expected_responses].positive? %>

<turbo-frame id="standup_analytics">
  <div class="page">
    <%= render "manager/shared/standup_header", standup: @standup, active: :insights %>

    <div class="flex wrap items-center justify-between gap-3">
      <div class="flex wrap items-center gap-3">
        <nav class="segmented" aria-label="Date range">
          <% [ 7, 30, 90 ].each do |days| %>
            <% selected = range_days.between?(days, days + 1) && @analytics.end_date == Date.current %>
            <%= link_to "#{days} days",
              manager_standup_analytics_path(@standup, start_date: (Date.current - (days - 1)).iso8601, end_date: Date.current.iso8601),
              class: (selected ? "is-active" : nil),
              "aria-current": (selected ? "true" : nil),
              data: { turbo_frame: "standup_analytics", turbo_action: "advance" } %>
          <% end %>
        </nav>
        <%= form_with url: manager_standup_analytics_path(@standup), method: :get, data: { turbo_frame: "standup_analytics", turbo_action: "advance" }, class: "flex items-center gap-2" do |form| %>
          <%= form.label :start_date, "Start date", class: "sr-only" %>
          <%= form.date_field :start_date, value: @analytics.start_date.iso8601 %>
          <span class="muted">–</span>
          <%= form.label :end_date, "End date", class: "sr-only" %>
          <%= form.date_field :end_date, value: @analytics.end_date.iso8601 %>
          <%= form.submit "Apply", class: "btn" %>
        <% end %>
      </div>
      <div class="btn-row">
        <%= link_to "Response history", manager_standup_responses_path(@standup, start_date: @analytics.start_date.iso8601, end_date: @analytics.end_date.iso8601), class: "btn", data: { turbo_frame: "_top" } %>
        <%= link_to manager_standup_analytics_path(@standup, format: :csv, start_date: @analytics.start_date.iso8601, end_date: @analytics.end_date.iso8601), class: "btn", data: { turbo: false } do %>
          <%= icon(:download) %> Export CSV
        <% end %>
      </div>
    </div>

    <% if @analytics.range_limited? %>
      <div class="alert alert-warning"><%= icon(:info) %><span>Showing the most recent <%= StandupAnalyticsService::MAX_RANGE_DAYS %> days.</span></div>
    <% end %>

    <dl class="stats">
      <div class="stat">
        <dt>Completion rate</dt>
        <dd>
          <%= has_data ? percent(@summary[:completion_rate]) : "—" %>
          <%= delta_badge(@summary[:completion_rate], @previous_completion_rate) if has_data %>
        </dd>
        <span class="stat-sub">vs. the previous <%= pluralize(range_days, "day") %></span>
      </div>
      <div class="stat">
        <dt>Responses</dt>
        <dd><%= @summary[:completed_responses] %><span class="muted small">/ <%= @summary[:expected_responses] %></span></dd>
        <span class="stat-sub">Completed of expected</span>
      </div>
      <div class="stat">
        <dt>Average response time</dt>
        <dd><%= @summary[:average_response_time_minutes] ? "#{@summary[:average_response_time_minutes].round} min" : "—" %></dd>
        <span class="stat-sub">From prompt to submission</span>
      </div>
      <div class="stat">
        <dt>Runs</dt>
        <dd><%= @runs.size %></dd>
        <span class="stat-sub"><%= @analytics.start_date.strftime("%b %-d") %> – <%= @analytics.end_date.strftime("%b %-d, %Y") %></span>
      </div>
    </dl>

    <section class="card">
      <div class="card-header">
        <div>
          <h2>Completion over time</h2>
          <p class="hint">Share of expected responses completed, per run</p>
        </div>
      </div>
      <div class="card-body">
        <%= rate_line_chart(@runs.map { |run| { label: run[:date].strftime("%b %-d"), value: run[:completion_rate], title: "#{run[:date].to_fs(:long)}: #{run[:completion_rate].round}% (#{run[:completed]}/#{run[:expected]})" } }, height: 240, width: 1000) %>
      </div>
    </section>

    <div class="grid grid-2 grid-gap-lg">
      <section class="card">
        <div class="card-header">
          <div>
            <h2>Responses per run</h2>
            <p class="hint">What happened to each prompt</p>
          </div>
          <%= run_legend(pending: @runs.any? { |run| run[:pending].positive? }) %>
        </div>
        <div class="card-body">
          <%= run_breakdown_chart(@runs, height: 200, width: 480) %>
        </div>
      </section>

      <section class="card card-flush">
        <div class="card-header">
          <div>
            <h2>Participation</h2>
            <p class="hint">Lowest completion first</p>
          </div>
        </div>
        <% if @participant_stats.any? %>
          <ul class="list">
            <% @participant_stats.each do |stat| %>
              <% name = stat[:slack_name].presence || stat[:slack_id] %>
              <li>
                <%= avatar(name, size: "sm") %>
                <div class="grow">
                  <div class="flex justify-between gap-2 small">
                    <span class="truncate strong"><%= name %></span>
                    <span class="muted nowrap">
                      <%= stat[:missed].positive? ? pluralize(stat[:missed], "missed response") : "No misses" %>
                    </span>
                  </div>
                  <div class="meter mt-1">
                    <%= progress_bar(stat[:completion_rate], tone: rate_tone(stat[:completion_rate])) %>
                    <span class="meter-value small"><%= stat[:expected].positive? ? percent(stat[:completion_rate]) : "—" %></span>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="empty-inline">No active participants.</p>
        <% end %>
      </section>
    </div>

    <section class="card">
      <div class="card-header">
        <div>
          <h2>Blockers</h2>
          <p class="hint">Words that come up most in blocker answers</p>
        </div>
      </div>
      <div class="card-body">
        <% if @blocker_keywords.any? %>
          <div class="chips">
            <% @blocker_keywords.each do |keyword| %>
              <span class="tag tag-warning"><%= keyword[:keyword] %> <span class="count"><%= keyword[:count] %></span></span>
            <% end %>
          </div>
        <% else %>
          <p class="muted">No recurring blockers in this period.</p>
        <% end %>
      </div>
    </section>

    <section class="stack">
      <h2>Answers by question</h2>
      <div class="grid grid-<%= [ @question_summaries.size, 3 ].min.clamp(1, 3) %>">
        <% @question_summaries.each do |question| %>
          <article class="card">
            <div class="card-header">
              <div>
                <h3><%= question[:question] %></h3>
                <p class="hint"><%= question[:answered] %> answered · <%= question[:skipped] %> skipped · <%= percent(question[:answer_rate]) %> answer rate</p>
              </div>
            </div>
            <div class="card-body">
              <% if question[:common_keywords].any? %>
                <div class="chips">
                  <% question[:common_keywords].each do |keyword| %>
                    <span class="tag"><%= keyword[:keyword] %> <span class="count"><%= keyword[:count] %></span></span>
                  <% end %>
                </div>
              <% end %>
              <% if question[:latest_answers].any? %>
                <div>
                  <% question[:latest_answers].each do |answer| %>
                    <blockquote class="quote">
                      <p><%= answer[:answer] %></p>
                      <footer class="xsmall muted mt-1">
                        <%= answer[:slack_name] %><% if answer[:answered_at].present? %> · <%= Time.zone.parse(answer[:answered_at]).strftime("%b %-d") %><% end %>
                      </footer>
                    </blockquote>
                  <% end %>
                </div>
              <% else %>
                <p class="muted small">No answers in this period.</p>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</turbo-frame>
