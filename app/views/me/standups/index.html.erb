<% content_for :title, "My standups" %>
<% rated = @summaries.select(&:stats) %>
<% expected_total = rated.sum { |summary| summary.stats[:expected] } %>
<% completed_total = rated.sum { |summary| summary.stats[:completed] } %>
<% next_up = @summaries.filter_map { |summary| [ summary, summary.next_check_in ] if summary.next_check_in }.min_by(&:last) %>
<% away_until = current_member.away_until %>

<div class="page">
  <div class="page-header">
    <div class="page-header-text">
      <h1>My standups</h1>
      <p class="page-subtitle">Your check-ins across <%= pluralize(@summaries.size, "standup") %>. Answer them in your Slack DMs.</p>
    </div>
    <%= link_to me_availability_path, class: "btn" do %>
      <%= icon(:calendar) %> Set time away
    <% end %>
  </div>

  <% if away_until %>
    <div class="alert alert-info">
      <%= icon(:info) %>
      <div class="grow">You're away through <strong><%= away_until.strftime("%A, %B %-d") %></strong>. You won't get check-ins until then.</div>
      <%= button_to "I'm back", clear_me_availability_path, method: :delete, class: "btn btn-sm" %>
    </div>
  <% end %>

  <dl class="stats">
    <div class="stat">
      <dt>Standups</dt>
      <dd><%= @summaries.size %></dd>
      <span class="stat-sub"><%= @summaries.count { |summary| summary.participant.active? && summary.standup.active? } %> active</span>
    </div>
    <div class="stat">
      <dt>Your completion · 30 days</dt>
      <dd><%= expected_total.positive? ? percent(completed_total * 100.0 / expected_total) : "—" %></dd>
      <span class="stat-sub"><%= completed_total %> of <%= expected_total %> check-ins</span>
    </div>
    <div class="stat">
      <dt>Next check-in</dt>
      <dd class="stat-value-sm"><%= next_up ? next_up.last.strftime("%a, %b %-d") : "—" %></dd>
      <span class="stat-sub"><%= next_up ? "#{next_up.last.strftime("%-l:%M %p %Z")} · #{next_up.first.standup.name}" : "Nothing scheduled" %></span>
    </div>
    <div class="stat">
      <dt>Status</dt>
      <dd class="stat-value-sm"><%= away_until ? "Away" : "Available" %></dd>
      <span class="stat-sub"><%= away_until ? "Back #{(away_until + 1).strftime("%b %-d")}" : "Getting check-ins as scheduled" %></span>
    </div>
  </dl>

  <div class="grid grid-2 grid-gap-lg">
    <% @summaries.each do |summary| %>
      <% standup = summary.standup %>
      <% status_label, status_tone = summary.status %>
      <% today = summary.today_response %>
      <section class="card" id="<%= dom_id(standup, :member) %>">
        <div class="card-header">
          <div>
            <h2><%= standup.name %></h2>
            <p class="hint">#<%= standup.platform_channel.to_s.delete_prefix("#") %></p>
          </div>
          <%= status_badge(status_label, status_tone) %>
        </div>
        <div class="card-body">
          <dl class="kv">
            <dt>Schedule</dt>
            <dd><%= schedule_summary(standup) %></dd>
            <dt>Next check-in</dt>
            <dd><%= summary.next_check_in ? summary.next_check_in.strftime("%a, %b %-d at %-l:%M %p %Z") : "—" %></dd>
            <dt>Today</dt>
            <dd>
              <% if today %>
                <%= status_badge(today.status == "completed" ? "Answered" : today.status.titleize) %>
              <% else %>
                <span class="muted">No check-in today</span>
              <% end %>
            </dd>
            <dt>Your completion</dt>
            <dd>
              <% if summary.completion_rate %>
                <div class="meter">
                  <%= progress_bar(summary.completion_rate, tone: rate_tone(summary.completion_rate)) %>
                  <span class="meter-value small"><%= percent(summary.completion_rate) %></span>
                </div>
              <% else %>
                <span class="muted">Not enough history yet</span>
              <% end %>
            </dd>
          </dl>
          <div class="flex items-center gap-2">
            <% if summary.teammates.any? %>
              <%= avatar_stack(summary.teammates, limit: 6) %>
              <span class="small muted">with <%= pluralize(summary.teammates.size, "teammate") %></span>
            <% else %>
              <span class="small muted">Just you so far</span>
            <% end %>
          </div>
        </div>
        <div class="card-footer">
          <%= link_to "My answers", me_responses_path(standup_id: standup.id), class: "btn btn-sm" %>
        </div>
      </section>
    <% end %>
  </div>

  <p class="small muted">Tip: in Slack, DM the bot <code>away 3</code> to skip the next three days, or <code>back</code> to return early.</p>
</div>
