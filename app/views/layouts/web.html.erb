<!DOCTYPE html>
<html>
  <head>
    <title>Standup Bot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/application.css?v=<%= File.mtime(Rails.root.join("public/application.css")).to_i %>">
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-umd.js",
      integrity: "sha384-2ePXINFSJiSCWUJkjFJGYdr2kyM132s7uBi9k+JISp4P+AjN9DXn4H/1enWEHu36",
      crossorigin: "anonymous",
      defer: true %>
  </head>
  <body class="app-body">
    <% if current_user %>
      <div class="app-shell">
        <aside class="app-sidebar" aria-label="Primary navigation">
          <a href="<%= manager_standups_path %>" class="brand" data-turbo-frame="_top">
            <span class="brand-mark">SB</span>
            <span>
              <span class="brand-title">Standup Bot</span>
              <span class="brand-subtitle">Team rituals, automated</span>
            </span>
          </a>

          <nav class="app-nav">
            <%= link_to "Dashboard",
              manager_standups_path,
              class: "app-nav-link #{request.path == manager_standups_path ? "is-active" : ""}",
              data: { turbo_frame: "_top", short: "D" } %>
            <%= link_to "Slack integration",
              manager_slack_integration_path,
              class: "app-nav-link #{request.path.start_with?(manager_slack_integration_path) ? "is-active" : ""}",
              data: { turbo_frame: "_top", short: "S" } %>
          </nav>
        </aside>

        <div class="app-workspace">
          <header class="app-topbar">
            <div>
              <p class="app-topbar-kicker">Manager console</p>
              <p class="app-topbar-title">Keep async standups moving without chasing updates.</p>
            </div>
            <div class="app-user">
              <span class="user-pill">
                <span><%= current_user.name %></span>
                <span class="role-badge"><%= current_user.role %></span>
              </span>
              <%= button_to "Sign out",
                session_path,
                method: :delete,
                form: { class: "sign-out-form", data: { turbo: false } },
                class: "button-secondary button-small" %>
            </div>
          </header>

          <main class="app-main">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="auth-shell">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
