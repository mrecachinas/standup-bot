<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Standup Bot" ].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">
    <script>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch (_) {}
    </script>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/application.css?v=<%= File.mtime(Rails.root.join("public/application.css")).to_i %>">
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-umd.js",
      integrity: "sha384-2ePXINFSJiSCWUJkjFJGYdr2kyM132s7uBi9k+JISp4P+AjN9DXn4H/1enWEHu36",
      crossorigin: "anonymous",
      defer: true %>
    <script src="/application.js?v=<%= File.mtime(Rails.root.join("public/application.js")).to_i %>" defer></script>
  </head>
  <body>
    <% if current_user || current_member %>
      <% current_standup_id = @standup&.persisted? ? @standup.id : nil %>
      <% display_name = current_user&.name || current_member.name %>
      <div class="app">
        <aside class="sidebar" aria-label="Primary">
          <%= link_to (current_user ? manager_standups_path : me_root_path), class: "brand", data: { turbo_frame: "_top" } do %>
            <span class="brand-mark"><%= icon(:logo) %></span>
            <span class="brand-name">Standup Bot</span>
          <% end %>

          <% if current_member %>
            <nav class="nav" aria-label="Me">
              <% if current_user %><div class="nav-label"><span>You</span></div><% end %>
              <%= nav_link "My standups", me_root_path, icon_name: :message,
                active: controller_path == "me/standups", data: { turbo_frame: "_top" } %>
              <%= nav_link "My responses", me_responses_path, icon_name: :inbox,
                active: controller_path == "me/responses", data: { turbo_frame: "_top" } %>
              <%= nav_link "Availability", me_availability_path, icon_name: :calendar,
                active: controller_path == "me/availability", data: { turbo_frame: "_top" } %>
            </nav>
          <% end %>

          <% if current_user %>
            <nav class="nav" aria-label="Main">
              <%= nav_link "Overview", manager_standups_path, icon_name: :grid,
                active: controller_path == "manager/standups" && action_name == "index", data: { turbo_frame: "_top" } %>
              <%= nav_link "Slack", manager_slack_integration_path, icon_name: :hash,
                active: controller_path == "manager/slack_integrations", data: { turbo_frame: "_top" } %>
              <% if current_user.admin? %>
                <%= nav_link "Admin", admin_root_path, icon_name: :shield,
                  active: controller_path.start_with?("admin/"), data: { turbo_frame: "_top" } %>
              <% end %>
            </nav>

            <nav class="nav nav-standups" aria-label="Standups">
              <div class="nav-label">
                <span>Standups</span>
                <%= link_to icon(:plus), new_manager_standup_path, title: "New standup", "aria-label": "New standup", data: { turbo_frame: "_top" } %>
              </div>
              <% if sidebar_standups.any? %>
                <% sidebar_standups.each do |standup| %>
                  <% active = standup.id == current_standup_id %>
                  <%= link_to manager_standup_path(standup),
                    class: [ "nav-item", active && "is-active" ].compact_blank.join(" "),
                    "aria-current": (active ? "page" : nil),
                    data: { turbo_frame: "_top" } do %>
                    <span class="dot <%= standup.active? ? "dot-success" : "dot-warning" %>" title="<%= standup.active? ? "Active" : "Paused" %>"></span>
                    <span class="truncate"><%= standup.name %></span>
                  <% end %>
                <% end %>
              <% else %>
                <p class="nav-empty">No standups yet</p>
              <% end %>
            </nav>
          <% end %>

          <div class="sidebar-footer">
            <div class="theme-switch" role="group" aria-label="Theme" data-theme-switch>
              <% [ [ "system", "Auto", :monitor ], [ "light", "Light", :sun ], [ "dark", "Dark", :moon ] ].each do |value, label, icon_name| %>
                <button type="button" data-theme-value="<%= value %>" aria-pressed="false" title="<%= label %> theme"><%= icon(icon_name) %><span><%= label %></span></button>
              <% end %>
            </div>
            <div class="user">
              <%= avatar(display_name, url: current_user&.avatar_url || current_member&.avatar_url) %>
              <div class="user-meta">
                <div class="user-name truncate"><%= display_name %></div>
                <div class="user-role"><%= current_user&.admin? ? "Admin" : "Member" %></div>
              </div>
              <%= button_to session_path,
                method: :delete,
                form: { data: { turbo: false } },
                class: "btn btn-ghost btn-sm btn-icon",
                title: "Sign out",
                "aria-label": "Sign out" do %>
                <%= icon(:logout) %>
              <% end %>
            </div>
          </div>
        </aside>

        <main class="main" id="main">
          <%= yield %>
        </main>
      </div>

      <% if flash.any? { |_, message| message.present? } %>
        <div class="flashes" data-flashes>
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <% tone = { "notice" => "success", "alert" => "danger" }.fetch(type.to_s, "warning") %>
            <div class="alert alert-<%= tone %>" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
              <%= icon(tone == "success" ? :check_circle : :alert) %>
              <span><%= message %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <main class="auth">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
