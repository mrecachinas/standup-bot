<% content_for :title, "Sign in" %>
<turbo-frame id="session">
  <div class="auth-card">
    <div class="brand">
      <span class="brand-mark"><%= icon(:logo) %></span>
      <span>Standup Bot</span>
    </div>

    <section class="card">
      <div class="card-body">
        <div>
          <h1>Sign in</h1>
          <p class="page-subtitle">Use the email and access token from your admin.</p>
        </div>

        <% if response.status == 401 %>
          <div class="alert alert-danger" role="alert"><%= icon(:alert) %><span>Invalid email or access token.</span></div>
        <% end %>

        <%= form_with url: session_path, method: :post, data: { turbo_frame: "_top" }, class: "stack" do |form| %>
          <div class="field">
            <%= form.label :email %>
            <%= form.email_field :email, value: @email, required: true, autofocus: @email.blank?, autocomplete: "email", placeholder: "you@company.com" %>
          </div>
          <div class="field">
            <%= form.label :access_token, "Access token" %>
            <%= form.password_field :access_token, value: @access_token, required: true, autocomplete: "current-password" %>
            <% if @access_token.present? %>
              <span class="hint">Local development credentials are pre-filled from the dev server environment.</span>
            <% end %>
          </div>
          <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
        <% end %>
      </div>
    </section>

    <p class="auth-footer">Async standups for Slack teams.</p>
  </div>
</turbo-frame>
