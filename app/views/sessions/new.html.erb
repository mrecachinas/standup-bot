<turbo-frame id="session">
  <section class="auth-card">
    <div class="auth-hero">
      <p class="page-kicker">Standup Bot</p>
      <h1>Run calmer async standups.</h1>
      <p class="mt-4 text-lg">Manage team check-ins, Slack delivery, response health, and reporting from one focused console.</p>

      <ul class="auth-feature-list">
        <li>
          <strong>Schedule with confidence</strong>
          <p class="mt-1 text-sm">Preview upcoming sends before saving cadence changes.</p>
        </li>
        <li>
          <strong>Spot follow-up quickly</strong>
          <p class="mt-1 text-sm">Review participation, blockers, and missed responses without opening Slack.</p>
        </li>
        <li>
          <strong>Keep setup safe</strong>
          <p class="mt-1 text-sm">Use IDs from Slack discovery without exposing secrets.</p>
        </li>
      </ul>
    </div>

    <div class="auth-panel">
      <p class="page-kicker">Manager access</p>
      <h1 class="text-3xl font-bold text-slate-900">Manager sign in</h1>
      <p class="mt-2 text-sm text-slate-600">Use the email and access token provisioned for your manager account.</p>

      <% if response.status == 401 %>
        <p class="alert alert-danger mt-4">Invalid email or access token.</p>
      <% end %>

      <%= form_with url: session_path, method: :post, data: { turbo_frame: "_top" }, class: "mt-6 space-y-4" do |form| %>
        <div>
          <%= form.label :email, class: "block text-sm font-semibold text-slate-700" %>
          <%= form.email_field :email, value: @email, required: true, autocomplete: "email", placeholder: "you@example.com", class: "mt-1" %>
        </div>
        <div>
          <%= form.label :access_token, "Access token", class: "block text-sm font-semibold text-slate-700" %>
          <%= form.password_field :access_token, value: @access_token, required: true, autocomplete: "current-password", placeholder: "Paste your token", class: "mt-1" %>
        </div>
        <% if @access_token.present? %>
          <p class="text-xs text-slate-500">Local development credentials are pre-filled from the dev server environment.</p>
        <% end %>
        <%= form.submit "Sign in", class: "button-primary w-full" %>
      <% end %>
    </div>
  </section>
</turbo-frame>
