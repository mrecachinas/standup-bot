#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Check if MySQL is reachable
check_mysql() {
  mysqladmin ping -h "${DB_HOST:-127.0.0.1}" -P "${DB_PORT:-3306}" -u "${DB_USER:-root}" --silent 2>/dev/null
}

if ! check_mysql; then
  echo "==> MySQL not running, starting via docker compose..."
  docker compose up -d --wait mysql
fi

echo "==> Preparing test database..."
bin/rails db:test:prepare

echo "==> Running tests..."
bin/rails test "$@"