#!/usr/bin/env bash
# Starts Rails for the Playwright end-to-end tests: development mode (so CSRF
# and sessions behave as in production) against a throwaway database loaded
# with the test fixtures. Expects the console to be built into public/app.

set -e

cd "$(dirname "$0")/.."

export RAILS_ENV=development
export DATABASE_URL="${E2E_DATABASE_URL:-mysql2://${DB_USER:-root}:${DB_PASSWORD:-}@${DB_HOST:-127.0.0.1}:${DB_PORT:-3306}/nerdbot_e2e}"
export ADMIN_API_TOKEN="${ADMIN_API_TOKEN:-e2e-admin-api-token}"

if [ ! -f public/app/index.html ]; then
  echo "public/app/index.html is missing. Run 'npm run build' in frontend/ first." >&2
  exit 1
fi

echo "==> Resetting the e2e database..."
DISABLE_DATABASE_ENVIRONMENT_CHECK=1 bin/rails db:drop db:create db:schema:load db:fixtures:load

echo "==> Starting Rails on port ${E2E_PORT:-3100}..."
exec bin/rails server -p "${E2E_PORT:-3100}" -b 127.0.0.1
